@@ -26,0 +32,44 @@ int wrap_npot(GLenum wrap);
+static GLuint gl4es_defaultFramebuffer(void) {
+    if (glstate->fbo.external_default_active)
+        return glstate->fbo.external_default_fbo;
+    return glstate->fbo.mainfbo_fbo;
+}
+
+static GLuint gl4es_nativeFramebuffer(const glframebuffer_t *framebuffer) {
+    if (framebuffer && framebuffer->id)
+        return framebuffer->id;
+    return gl4es_defaultFramebuffer();
+}
+
+GLuint gl4es_getDefaultFBO(void) {
+    return gl4es_defaultFramebuffer();
+}
+
+int set_external_default_framebuffer(GLuint framebuffer) {
+    if (!glstate)
+        return 0;
+
+    if (!framebuffer) {
+        glstate->fbo.external_default_active = GL_FALSE;
+        glstate->fbo.external_default_fbo = 0;
+        ++glstate->fbo.external_default_generation;
+        return 1;
+    }
+
+    if (!glstate->fbo.external_default_active ||
+        glstate->fbo.external_default_fbo != framebuffer)
+        ++glstate->fbo.external_default_generation;
+    glstate->fbo.external_default_fbo = framebuffer;
+    glstate->fbo.external_default_active = GL_TRUE;
+
+    // Registration happens with GL4ES logical zero current. Rebind both native
+    // read and draw targets immediately so the cache and embedder agree.
+    if (glstate->fbo.fbo_read && glstate->fbo.fbo_draw &&
+        glstate->fbo.fbo_read->id == 0 && glstate->fbo.fbo_draw->id == 0) {
+        LOAD_GLES2_OR_OES(glBindFramebuffer);
+        gles_glBindFramebuffer(GL_FRAMEBUFFER, gl4es_defaultFramebuffer());
+        glstate->fbo.current_fb = glstate->fbo.fbo_0;
+    }
+    return 1;
+}
