+#define GL4ES_EXTERNAL_DEFAULT_STATE_VERSION 1
+typedef struct gl4es_external_default_state_s {
+    unsigned int version;
+    unsigned int size;
+    unsigned int registered_framebuffer;
+    unsigned int generation;
+    unsigned int logical_current;
+    unsigned int logical_read;
+    unsigned int logical_draw;
+    unsigned int native_draw;
+    unsigned int native_read;
+    unsigned int framebuffer_status;
+    unsigned int checksum_valid;
+    unsigned int checksum;
+} gl4es_external_default_state_t;
+
+// Register an embedder-owned nonzero default FBO. Passing zero clears it.
+// GL4ES maps logical framebuffer zero to this object but never owns its storage.
+int set_external_default_framebuffer(unsigned int framebuffer);
+int gl4es_external_default_framebuffer_state(int width, int height,
+    int sample_pixels, gl4es_external_default_state_t *state);
+
