+static GLuint gl4es_externalDefaultChecksum(int width, int height) {
+    LOAD_GLES(glReadPixels);
+    GLubyte pixels[5][4 * 4 * 4];
+    int x[5] = { 0, width > 4 ? width - 4 : 0, 0,
+        width > 4 ? width - 4 : 0, width > 4 ? (width - 4) / 2 : 0 };
+    int y[5] = { 0, 0, height > 4 ? height - 4 : 0,
+        height > 4 ? height - 4 : 0, height > 4 ? (height - 4) / 2 : 0 };
+    int rw = width < 4 ? width : 4;
+    int rh = height < 4 ? height : 4;
+    GLuint hash = 2166136261u;
+    size_t bytes = (size_t)rw * (size_t)rh * 4;
+
+    memset(pixels, 0, sizeof(pixels));
+    for (int i = 0; i < 5; ++i)
+        gles_glReadPixels(x[i], y[i], rw, rh, GL_RGBA, GL_UNSIGNED_BYTE, pixels[i]);
+    for (int i = 0; i < 5; ++i)
+        for (size_t j = 0; j < bytes; ++j) {
+            hash ^= pixels[i][j];
+            hash *= 16777619u;
+        }
+    return hash;
+}
+
+int gl4es_external_default_framebuffer_state(int width, int height,
+    int sample_pixels, gl4es_external_default_state_t *state) {
+    LOAD_GLES(glGetIntegerv);
+    LOAD_GLES2_OR_OES(glCheckFramebufferStatus);
+    GLint native_draw = 0;
+    GLint native_read = 0;
+
+    if (!state || !glstate)
+        return 0;
+    memset(state, 0, sizeof(*state));
+    state->version = GL4ES_EXTERNAL_DEFAULT_STATE_VERSION;
+    state->size = sizeof(*state);
+    state->registered_framebuffer = glstate->fbo.external_default_active
+        ? glstate->fbo.external_default_fbo : 0;
+    state->generation = glstate->fbo.external_default_generation;
+    state->logical_current = glstate->fbo.current_fb ? glstate->fbo.current_fb->id : ~0u;
+    state->logical_read = glstate->fbo.fbo_read ? glstate->fbo.fbo_read->id : ~0u;
+    state->logical_draw = glstate->fbo.fbo_draw ? glstate->fbo.fbo_draw->id : ~0u;
+    // GL4ES runs on GLES2 here, where read/draw share one native binding.
+    // Querying the combined binding avoids relying on unsupported split enums.
+    gles_glGetIntegerv(GL_FRAMEBUFFER_BINDING, &native_draw);
+    native_read = native_draw;
+    state->native_draw = native_draw;
+    state->native_read = native_read;
+
+    if (!state->registered_framebuffer ||
+        state->logical_current || state->logical_read || state->logical_draw ||
+        state->native_draw != state->registered_framebuffer ||
+        state->native_read != state->registered_framebuffer)
+        return 0;
+
+    state->framebuffer_status = gles_glCheckFramebufferStatus(GL_FRAMEBUFFER);
+    if (state->framebuffer_status != GL_FRAMEBUFFER_COMPLETE)
+        return 0;
+    if (sample_pixels && width > 0 && height > 0) {
+        state->checksum = gl4es_externalDefaultChecksum(width, height);
+        state->checksum_valid = 1;
+    }
+    return 1;
@@ -1509 +1618 @@ void gl4es_setCurrentFBO() {
-  gles_glBindFramebuffer(GL_FRAMEBUFFER, (glstate->fbo.current_fb->id)?glstate->fbo.current_fb->id:glstate->fbo.mainfbo_fbo);
+  gles_glBindFramebuffer(GL_FRAMEBUFFER, gl4es_nativeFramebuffer(glstate->fbo.current_fb));
@@ -1726,4 +1835,3 @@ void gl4es_saveCurrentFBO()
-    // this, in fact, bind FBO to 0 if it wasn't
-    GLuint framebuffer = (glstate->fbo.current_fb)?glstate->fbo.current_fb->id:0;
-    if(framebuffer==0)
-        framebuffer = glstate->fbo.mainfbo_fbo;
+    // Temporarily leave an ordinary FBO without violating an embedder-owned
+    // logical-zero mapping.
+    GLuint framebuffer = gl4es_nativeFramebuffer(glstate->fbo.current_fb);
@@ -1734 +1842 @@ void gl4es_saveCurrentFBO()
-        gles_glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        gles_glBindFramebuffer(GL_FRAMEBUFFER, gl4es_defaultFramebuffer());
@@ -1741,3 +1849 @@ void gl4es_restoreCurrentFBO()
-    GLuint framebuffer = (glstate->fbo.current_fb)?glstate->fbo.current_fb->id:0;
-    if(framebuffer==0)
-        framebuffer = glstate->fbo.mainfbo_fbo;
+    GLuint framebuffer = gl4es_nativeFramebuffer(glstate->fbo.current_fb);
