+bool CStudioModelRenderer::WO49BeginTransform( const gl_studiomesh_t *entry,
+	const vbomesh_t *mesh, int num_bones, bool bones_upload, float foliage_sway_height )
+{
+	if( wo49_transform_claimed || !entry || !mesh || !entry->wo49_token ||
+		!bones_upload || mesh->wo49_layout != 1 || !entry->model || !worldmodel ||
+		Q_stricmp( entry->model->name, "models/bmec/cars/truck_new.mdl" ) ||
+		Q_stricmp( worldmodel->name, "maps/ch1map0.bsp" ) )
+		return false;
+
+	WO49ResolveTopologyAPI();
+	if( !pWO49TransformBegin )
+		return false;
+
+	const glsl_program_t *shader = &glsl_programs[entry->hProgram];
+	const bool rigid = Q_stristr( shader->options, "#define MAXSTUDIOBONES 1" ) != NULL;
+	const bool vertex_lighting = Q_stristr( shader->options, "STUDIO_VERTEX_LIGHTING" ) != NULL;
+	const bool bone_weighting = Q_stristr( shader->options, "STUDIO_BONEWEIGHTING" ) != NULL;
+	const bool sway = Q_stristr( shader->options, "STUDIO_SWAY_FOLIAGE" ) != NULL;
+	if( !rigid || !vertex_lighting || bone_weighting )
+		return false;
+
+	wo49_transform_producer_desc_t desc;
+	memset( &desc, 0, sizeof( desc ) );
+	desc.version = WO49_TRANSFORM_VERSION;
+	desc.size = sizeof( desc );
+	desc.token = entry->wo49_token;
+	desc.frame = tr.realframecount;
+	desc.generation = 1;
+	desc.producer = "CStudioModelRenderer::DrawStudioMeshes";
+	desc.map = worldmodel->name;
+	desc.model = entry->model->name;
+	desc.programIndex = entry->hProgram;
+	desc.programHandle = shader->handle;
+	desc.optionsHash = WO49Checksum( shader->options, Q_strlen( shader->options ) );
+	desc.flags = WO49_TRANSFORM_RIGID | WO49_TRANSFORM_VERTEX_LIGHTING;
+	if( sway ) desc.flags |= WO49_TRANSFORM_SWAY;
+	desc.elementOrdinal = 0;
+	desc.localIndex = mesh->wo49_firstIndex;
+	memcpy( desc.localPosition, mesh->wo49_firstPosition, sizeof( desc.localPosition ) );
+	memcpy( desc.boneQuaternion, &m_pModelInstance->m_studioquat[0][0], sizeof( desc.boneQuaternion ) );
+	memcpy( desc.bonePosition, &m_pModelInstance->m_studiopos[0][0], sizeof( desc.bonePosition ) );
+	RI->modelviewMatrix.CopyToArray( desc.modelview );
+	RI->projectionMatrix.CopyToArray( desc.projection );
+	const matrix4x4 mvp = RI->projectionMatrix.Concat( RI->modelviewMatrix );
+	mvp.CopyToArray( desc.mvp );
+
+	Vector4D local( desc.localPosition[0], desc.localPosition[1], desc.localPosition[2], 1.0f );
+	if( sway && local.z > foliage_sway_height )
+	{
+		local.x += local.z * 0.025f * sinf( local.z + tr.time * 0.25f );
+		local.y += local.z * 0.025f * cosf( local.z + tr.time * 0.25f );
+	}
+	const matrix4x4 bone( m_pModelInstance->m_studiopos[0], m_pModelInstance->m_studioquat[0] );
+	const Vector4D world = bone.VectorTransform( local );
+	const Vector4D clip = mvp.VectorTransform( world );
+	memcpy( desc.clipPosition, &clip[0], sizeof( desc.clipPosition ) );
+	desc.boneQuaternionLocation = shader->u_BoneQuaternion;
+	desc.bonePositionLocation = shader->u_BonePosition;
+	desc.boneQuaternionCount = num_bones;
+	desc.bonePositionCount = num_bones;
+	desc.swayHeight = foliage_sway_height;
+	desc.realTime = tr.time;
+
+	if( !pWO49TransformBegin( &desc ) )
+		return false;
+	wo49_transform_claimed = true;
+	return true;
+}
 #endif
 
