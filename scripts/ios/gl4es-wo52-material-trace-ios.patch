+unsigned long long APIENTRY_GL4ES gl4es_wo52_material_begin(
+    const ios_wo52_material_producer_desc_t *desc)
+{
+    ios_wo52_material_record_t *record;
+    char units[1536] = "";
+    size_t used = 0;
+    if(!desc || desc->version != IOS_WO52_MATERIAL_VERSION ||
+       desc->size != sizeof(*desc) || !desc->meshIdentity ||
+       !desc->model || !desc->materialName || !desc->unitCount ||
+       desc->unitCount > IOS_WO52_MATERIAL_UNIT_CAP)
+        return 0;
+    for(unsigned int i = 0; i < ios_wo52_material_count; ++i) {
+        const ios_wo52_material_record_t *existing = &ios_wo52_material_records[i];
+        if(existing->producer.generation == desc->generation &&
+           existing->producer.entity == desc->entity &&
+           existing->producer.skin == desc->skin &&
+           existing->producer.bodypart == desc->bodypart &&
+           existing->producer.mesh == desc->mesh &&
+           existing->producer.material == desc->material &&
+           existing->producer.lightpass == desc->lightpass &&
+           existing->producer.meshIdentity == desc->meshIdentity &&
+           strcmp(existing->model, desc->model) == 0)
+            return 0;
+    }
+    if(ios_wo52_material_count >= IOS_WO52_MATERIAL_TOKEN_CAP) {
+        ++ios_wo52_material_overflow;
+        if(ios_wo52_material_overflow == 1)
+            ios_wo49_emit("WO52 material trace summary: selected=256 cap=256 terminal=%u incomplete=%u overflow=1 selection=closed",
+                ios_wo52_material_terminal_count, ios_wo52_material_incomplete_count);
+        return 0;
+    }
+    record = &ios_wo52_material_records[ios_wo52_material_count++];
+    memset(record, 0, sizeof(*record));
+    record->token = ++ios_wo52_material_next_token;
+    record->producer = *desc;
+    snprintf(record->map, sizeof(record->map), "%s", desc->map ? desc->map : "<none>");
+    snprintf(record->model, sizeof(record->model), "%s", desc->model);
+    snprintf(record->material, sizeof(record->material), "%s", desc->materialName);
+    snprintf(record->source, sizeof(record->source), "%s",
+        desc->sourceName ? desc->sourceName : "<none>");
+    record->producer.map = record->map;
+    record->producer.model = record->model;
+    record->producer.materialName = record->material;
+    record->producer.sourceName = record->source;
+    record->stage_mask = 0x03u;
+    if(!ios_wo52_material_policy_emitted) {
+        ios_wo52_material_policy_emitted = 1;
+        ios_wo49_emit("WO52 material trace policy: identities<=256 key=generation+entity+model+skin+bodypart+mesh+material first-draw+first-post-transition stages=producer+shader+bind+gl4es+native+transition+terminal direct+deferred+renderlist+replay sink=engine-console fixed-storage=1 state_restore=not-required native-shadow=post-realization error_queue=untouched repair=none");
+    }
+    for(unsigned int i = 0; i < desc->unitCount; ++i) {
+        const ios_wo52_material_unit_desc_t *u = &desc->units[i];
+        ios_wo49_append(units, sizeof(units), &used,
+            "%su%u:t0x%04x:engine%u:logical%u:%ux%u:f0x%04x:flags0x%x:mode%d:ready%d:loc%d:value%d",
+            i ? "," : "", u->unit, u->target, u->engineObject,
+            u->logicalObject, u->width, u->height, u->format,
+            u->resourceFlags, u->mode, u->ready, u->samplerLocation,
+            u->samplerValue);
+    }
+    ios_wo49_emit(
+        "WO52 material trace producer: token=%llu frame=%llu generation=%u map=%s entity=%u model_handle=%u model=%s skin=%u bodypart=%d mesh=%d mesh_identity=0x%llx material_slot=%d material_name=%s source=%s flags=0x%x gl_diffuse_id=%d selected_mode=%s selected_object=%u fallback=%d animation_id=%d monitor=%d drone=%d normal=%d cube=%d interior=%d blend=%d mask=%d cache_epoch=%u lightpass=%u units=[%s]",
+        record->token, desc->frame, desc->generation, record->map,
+        desc->entity, desc->modelHandle, record->model, desc->skin,
+        desc->bodypart, desc->mesh,
+        desc->meshIdentity, desc->material, record->material, record->source,
+        desc->materialFlags, desc->diffuseObject,
+        ios_wo52_material_mode_name(desc->units[0].mode),
+        desc->units[0].engineObject, desc->fallbackObject, desc->animationId,
+        desc->monitorObject, desc->droneObject, desc->normalObject,
+        desc->cubemapObject, desc->interiorObject, desc->blendObject,
+        desc->maskObject, desc->cacheEpoch, desc->lightpass, units);
+    ios_wo49_emit(
+        "WO52 material trace shader: token=%llu shader_index=%u logical_program=%u options_hash=%08x status=0x%x u_ColorMap_location=%d u_RenderColor_location=%d u_MeshParams_location=%d u_StudioLighting_location=%d render_color=[%.6g,%.6g,%.6g,%.6g] mesh_params=[%.6g,%.6g,%.6g,%.6g] fullbright=%u additive=%u vertex_lighting=%u",
+        record->token, desc->shaderIndex, desc->logicalProgram,
+        desc->optionsHash, desc->shaderStatus, desc->colorMapLocation,
+        desc->renderColorLocation, desc->meshParamsLocation,
+        desc->studioLightingLocation, desc->renderColor[0], desc->renderColor[1],
+        desc->renderColor[2], desc->renderColor[3], desc->meshParams[0],
+        desc->meshParams[1], desc->meshParams[2], desc->meshParams[3],
+        desc->fullbright, desc->additive, desc->vertexLighting);
+    ios_wo52_material_pending = record->token;
+    return record->token;
+}
+
+void APIENTRY_GL4ES gl4es_wo52_engine_bind(unsigned int unit,
+    unsigned int target, unsigned int engineObject, unsigned int requestedLogical,
+    unsigned int beforeLogical, unsigned int beforeIndex, unsigned int beforeTarget,
+    unsigned int afterLogical, unsigned int afterIndex, unsigned int afterTarget,
+    int issued)
+{
+    ios_wo52_material_record_t *record = ios_wo52_material_find(ios_wo52_material_pending);
+    int slot;
+    if(!record || (slot = ios_wo52_material_unit_slot(record, unit)) < 0)
+        return;
+    ios_wo52_engine_bind_t *b = &record->engine[slot];
+    b->seen = 1;
+    b->target = target;
+    b->engine_object = engineObject;
+    b->requested_logical = requestedLogical;
+    b->before_logical = beforeLogical;
+    b->before_index = beforeIndex;
+    b->before_target = beforeTarget;
+    b->after_logical = afterLogical;
+    b->after_index = afterIndex;
+    b->after_target = afterTarget;
+    b->issued = issued;
+}
+
+void ios_wo52_material_gl4es_bind(unsigned int unit, unsigned int target,
+    unsigned int logicalObject, unsigned int nativeObject, int equal)
+{
+    ios_wo52_material_record_t *record = ios_wo52_material_find(ios_wo52_material_pending);
+    int slot;
+    if(!record || (slot = ios_wo52_material_unit_slot(record, unit)) < 0)
+        return;
+    record->gl4es[slot].seen = 1;
+    record->gl4es[slot].target = target;
+    record->gl4es[slot].logical = logicalObject;
+    record->gl4es[slot].native = nativeObject;
+    record->gl4es[slot].equal = equal;
+}
+
+void APIENTRY_GL4ES gl4es_wo52_material_cache(
+    const ios_wo52_material_cache_desc_t *desc)
+{
+    ios_wo52_material_record_t *record;
+    char units[2048] = "";
+    size_t used = 0;
+    if(!desc || desc->version != IOS_WO52_MATERIAL_VERSION ||
+       desc->size != sizeof(*desc) ||
+       !(record = ios_wo52_material_find(desc->token)))
+        return;
+    record->cache = *desc;
+    record->cache.unitCount = desc->unitCount > IOS_WO52_MATERIAL_UNIT_CAP ?
+        IOS_WO52_MATERIAL_UNIT_CAP : desc->unitCount;
+    record->stage_mask |= 0x04u;
+    for(unsigned int i = 0; i < record->cache.unitCount; ++i) {
+        const ios_wo52_material_cache_unit_t *c = &record->cache.units[i];
+        int slot = ios_wo52_material_unit_slot(record, c->unit);
+        const ios_wo52_engine_bind_t empty_engine = {0};
+        const ios_wo52_gl4es_bind_t empty_gl4es = {0};
+        const ios_wo52_engine_bind_t *e = slot >= 0 ?
+            &record->engine[slot] : &empty_engine;
+        const ios_wo52_gl4es_bind_t *g = slot >= 0 ?
+            &record->gl4es[slot] : &empty_gl4es;
+        ios_wo49_append(units, sizeof(units), &used,
+            "%su%u:req%d:diff_before%d/m%d:diff_after%d/m%d:issued%d:engine_seen%d/before%u/%u/t0x%x:after%u/%u/t0x%x:inner_issued%d:gl4es_seen%d/logical%u/native%u/equal%d",
+            i ? "," : "", c->unit, c->requestedObject, c->beforeObject,
+            c->beforeMode, c->afterObject, c->afterMode, c->issued,
+            e->seen, e->before_index, e->before_logical, e->before_target,
+            e->after_index, e->after_logical, e->after_target, e->issued,
+            g->seen, g->logical, g->native, g->equal);
+    }
+    ios_wo49_emit("WO52 material trace bind: token=%llu cache_epoch=%u units=[%s]",
+        record->token, desc->cacheEpoch, units);
+}
+
+void APIENTRY_GL4ES gl4es_wo52_material_arm(unsigned long long token)
+{
+    if(ios_wo52_material_find(token))
+        ios_wo52_material_pending = token;
+}
+
+unsigned long long ios_wo52_material_ingress(const char *function,
+    int deferred, int intercept)
+{
+    unsigned long long token = ios_wo52_material_pending;
+    ios_wo52_material_record_t *record = ios_wo52_material_find(token);
+    if(!record)
+        return 0;
+    ios_wo52_material_pending = 0;
+    snprintf(record->ingress, sizeof(record->ingress), "%s", function ? function : "unknown");
+    snprintf(record->route, sizeof(record->route), "%s",
+        intercept ? "intercept-renderlist" : (deferred ? "deferred-renderlist" : "direct"));
+    record->stage_mask |= 0x08u;
+    char units[1536] = "";
+    size_t used = 0;
+    for(unsigned int i = 0; i < record->producer.unitCount; ++i) {
+        const ios_wo52_material_unit_desc_t *p = &record->producer.units[i];
+        GLuint itarget = what_target(p->target);
+        gltexture_t *tex = p->unit < MAX_TEX ? glstate->texture.bound[p->unit][itarget] : NULL;
+        ios_wo49_append(units, sizeof(units), &used,
+            "%su%u:target0x%04x:logical%u:glname%u:enabled0x%x:actual%u",
+            i ? "," : "", p->unit, p->target, tex ? tex->texture : 0,
+            tex ? tex->glname : 0,
+            p->unit < MAX_TEX ? glstate->enable.texture[p->unit] : 0,
+            p->unit < MAX_TEX ? glstate->actual_tex2d[p->unit] : 0);
+    }
+    ios_wo49_emit(
+        "WO52 material trace gl4es: token=%llu ingress=%s route=%s deferred=%d intercept=%d bound_changed=%d logical_program=%u units=[%s]",
+        token, record->ingress, record->route, deferred, intercept,
+        glstate->bound_changed, glstate->glsl->program, units);
+    return token;
+}
+
+void ios_wo52_material_route(unsigned long long token, const char *route)
+{
+    ios_wo52_material_record_t *record = ios_wo52_material_find(token);
+    if(record && route)
+        snprintf(record->route, sizeof(record->route), "%s", route);
+}
+
+void ios_wo52_material_set_active(unsigned long long token)
+{
+    ios_wo52_material_active = token;
+}
+
+void ios_wo52_material_set_replay(const unsigned long long *tokens,
+    unsigned int count, const char *route)
+{
+    memset(&ios_wo52_material_replay, 0, sizeof(ios_wo52_material_replay));
+    if(!tokens)
+        return;
+    ios_wo52_material_replay.count = count > IOS_WO52_MATERIAL_LIST_CAP ?
+        IOS_WO52_MATERIAL_LIST_CAP : count;
+    memcpy(ios_wo52_material_replay.tokens, tokens,
+        ios_wo52_material_replay.count * sizeof(tokens[0]));
+    snprintf(ios_wo52_material_replay.route, sizeof(ios_wo52_material_replay.route),
+        "%s", route ? route : "replay");
+}
+
+void ios_wo52_material_route_loss(unsigned long long token, const char *reason)
+{
+    ios_wo52_material_record_t *record = ios_wo52_material_find(token);
+    if(!record)
+        return;
+    snprintf(record->missing, sizeof(record->missing), "%s", reason ? reason : "route-loss");
+    ios_wo52_material_terminal(record, "incomplete/overflow", record->missing);
+}
+
+static void ios_wo52_material_native_one(ios_wo52_material_record_t *record,
+    const char *function, const char *route)
+{
+    char units[2304] = "";
+    size_t used = 0;
+    program_t *program = glstate->gleshard->glprogram;
+    if(!record || record->terminal)
+        return;
+    if(route)
+        snprintf(record->route, sizeof(record->route), "%s", route);
+    record->stage_mask |= 0x10u;
+    for(unsigned int i = 0; i < record->producer.unitCount; ++i) {
+        const ios_wo52_material_unit_desc_t *p = &record->producer.units[i];
+        GLuint itarget = what_target(p->target);
+        gltexture_t *tex = p->unit < MAX_TEX ? glstate->texture.bound[p->unit][itarget] : NULL;
+        GLuint native_binding = p->target == GL_TEXTURE_CUBE_MAP ?
+            record->gl4es[i].native :
+            (p->unit < MAX_TEX ? glstate->actual_tex2d[p->unit] : 0);
+        const char *binding_name = p->target == GL_TEXTURE_CUBE_MAP ?
+            "GL_TEXTURE_BINDING_CUBE_MAP" : "GL_TEXTURE_BINDING_2D";
+        glsampler_t *sampler = tex ?
+            (glstate->samplers.sampler[p->unit] ? glstate->samplers.sampler[p->unit] : &tex->sampler) : NULL;
+        int reflected = 0, sampler_unit = -1, sampler_actual = -1;
+        int sampler_location = -1, sampler_extent = 0, sampler_value = -1;
+        GLenum sampler_type = 0;
+        const char *sampler_name = "<none>";
+        if(program) {
+            for(int j = 0; j < MAX_TEX && program->texunits[j].type; ++j) {
+                if(program->texunits[j].req_tu == (int)p->unit) {
+                    reflected = 1;
+                    sampler_unit = program->texunits[j].req_tu;
+                    sampler_actual = program->texunits[j].act_tu;
+                    sampler_name = GetUniformName(program, program->texunits[j].id);
+                    uniform_t *uniform = ios_wo52_material_uniform_location(
+                        program, program->texunits[j].id);
+                    if(uniform) {
+                        sampler_location = uniform->id;
+                        sampler_type = uniform->type;
+                        sampler_extent = uniform->size;
+                        sampler_value = GetUniformi(program, uniform->id);
+                    }
+                    break;
+                }
+            }
+        }
+        ios_wo49_append(units, sizeof(units), &used,
+            "%su%u:logical%u:glname%u:%s=%u:binding_source=%s:level0=%dx%d/internal0x%04x/format0x%04x:valid%d:min0x%04x:mag0x%04x:wrap0x%04x/0x%04x:mipmap_done%d:reflected%d:sampler=%s:type0x%04x:extent%d:native_location%d:value%d:req%d:act%d",
+            i ? "," : "", p->unit, tex ? tex->texture : 0,
+            tex ? tex->glname : 0, binding_name, native_binding,
+            p->target == GL_TEXTURE_CUBE_MAP ?
+                "gl4es-immediate-bind-observation" : "gl4es-native-shadow",
+            tex ? tex->width : 0, tex ? tex->height : 0,
+            tex ? tex->internalformat : 0, tex ? tex->format : 0,
+            tex ? tex->valid : 0, sampler ? sampler->min_filter : 0,
+            sampler ? sampler->mag_filter : 0, sampler ? sampler->wrap_s : 0,
+            sampler ? sampler->wrap_t : 0, tex ? tex->mipmap_done : 0,
+            reflected, sampler_name ? sampler_name : "<none>", sampler_type,
+            sampler_extent, sampler_location, sampler_value, sampler_unit,
+            sampler_actual);
+    }
+    uniform_t *render_color = ios_wo52_material_uniform(program, "u_RenderColor");
+    uniform_t *mesh_params = ios_wo52_material_uniform(program, "u_MeshParams");
+    uniform_t *studio_lighting = ios_wo52_material_uniform(program, "u_StudioLighting");
+    GLfloat native_color[4] = {0};
+    GLfloat native_mesh_params[3] = {0};
+    if(render_color && render_color->cache_size >= 4 * (int)sizeof(GLfloat))
+        memcpy(native_color, (char *)program->cache.cache + render_color->cache_offs,
+            sizeof(native_color));
+    if(mesh_params && mesh_params->cache_size >= 9 * (int)sizeof(GLfloat))
+        memcpy(native_mesh_params, (char *)program->cache.cache +
+            mesh_params->cache_offs + 6 * sizeof(GLfloat), sizeof(native_mesh_params));
+    uint32_t lighting_hash = studio_lighting && studio_lighting->cache_size > 0 ?
+        ios_wo49_bytes_checksum((char *)program->cache.cache +
+            studio_lighting->cache_offs, studio_lighting->cache_size) : 0;
+    ios_wo49_emit(
+        "WO52 material trace native: token=%llu function=%s route=%s immediately_pre_native_draw=1 post_realize_textures=1 post_program_realization=1 native_active_unit=%u native_program=%u logical_program=%u logical_program_match=%d units=[%s] render_color=type0x%04x/extent%d/value[%.6g,%.6g,%.6g,%.6g]/match%d mesh_params2=type0x%04x/extent%d/value[%.6g,%.6g,%.6g]/match%d studio_lighting=type0x%04x/extent%d/hash%08x state_restored=not-mutated error_queue=untouched",
+        record->token, function ? function : "unknown", record->route,
+        glstate->gleshard->active, glstate->gleshard->program,
+        glstate->glsl->program,
+        glstate->glsl->program == record->producer.logicalProgram, units,
+        render_color ? render_color->type : 0, render_color ? render_color->size : 0,
+        native_color[0], native_color[1], native_color[2], native_color[3],
+        render_color && !memcmp(native_color, record->producer.renderColor,
+            sizeof(native_color)), mesh_params ? mesh_params->type : 0,
+        mesh_params ? mesh_params->size : 0, native_mesh_params[0],
+        native_mesh_params[1], native_mesh_params[2],
+        mesh_params && !memcmp(native_mesh_params, record->producer.meshParams,
+            sizeof(native_mesh_params)), studio_lighting ? studio_lighting->type : 0,
+        studio_lighting ? studio_lighting->size : 0, lighting_hash);
+    ios_wo52_material_classify_native(record);
+}
+
+void ios_wo52_material_native(const char *function)
+{
+    if(ios_wo52_material_active) {
+        ios_wo52_material_native_one(
+            ios_wo52_material_find(ios_wo52_material_active), function, "direct");
+        ios_wo52_material_active = 0;
+    }
+    for(unsigned int i = 0; i < ios_wo52_material_replay.count; ++i)
+        ios_wo52_material_native_one(
+            ios_wo52_material_find(ios_wo52_material_replay.tokens[i]), function,
+            ios_wo52_material_replay.route);
+    memset(&ios_wo52_material_replay, 0, sizeof(ios_wo52_material_replay));
+}
+
+void APIENTRY_GL4ES gl4es_wo52_material_finish(unsigned long long token)
+{
+    ios_wo52_material_record_t *record = ios_wo52_material_find(token);
+    if(!record)
+        return;
+    record->finished = 1;
+    if(!record->terminal && strcmp(record->route, "direct") == 0)
+        ios_wo52_material_terminal(record, "incomplete/overflow", "immediate-native-stage");
+}
+
+void APIENTRY_GL4ES gl4es_wo52_material_transition(const char *event,
+    unsigned int generation, unsigned long long frame, const char *map)
+{
+    ios_wo49_emit(
+        "WO52 material trace transition: event=%s generation=%u frame=%llu map=%s selected=%u terminal=%u",
+        event ? event : "unknown", generation, frame, map ? map : "<none>",
+        ios_wo52_material_count, ios_wo52_material_terminal_count);
+    for(unsigned int i = 0; i < ios_wo52_material_count; ++i) {
+        ios_wo52_material_record_t *record = &ios_wo52_material_records[i];
+        if(!record->terminal && record->producer.generation < generation)
+            ios_wo52_material_terminal(record, "incomplete/overflow",
+                record->stage_mask & 0x08u ? "post-transition-native-stage" :
+                "post-transition-route-stage");
+    }
+}
