+static ios_wo52_material_record_t *ios_wo52_material_find(unsigned long long token)
+{
+    for(unsigned int i = 0; i < ios_wo52_material_count; ++i)
+        if(ios_wo52_material_records[i].token == token)
+            return &ios_wo52_material_records[i];
+    return NULL;
+}
+
+static int ios_wo52_material_unit_slot(const ios_wo52_material_record_t *record,
+    unsigned int unit)
+{
+    for(unsigned int i = 0; i < record->producer.unitCount; ++i)
+        if(record->producer.units[i].unit == unit)
+            return (int)i;
+    return -1;
+}
+
+static const char *ios_wo52_material_mode_name(int mode)
+{
+    switch(mode) {
+        case -1: return "invalid";
+        case 0: return "base";
+        case 1: return "white";
+        case 2: return "colormap";
+        case 3: return "monitor";
+        case 4: return "fallback";
+        case 5: return "animated";
+        case 6: return "drone";
+        case 7: return "interior";
+        case 8: return "blend";
+        default: return "unknown";
+    }
+}
+
+static const ios_wo52_material_cache_unit_t *ios_wo52_material_cache_unit(
+    const ios_wo52_material_record_t *record, unsigned int unit)
+{
+    for(unsigned int i = 0; i < record->cache.unitCount; ++i)
+        if(record->cache.units[i].unit == unit)
+            return &record->cache.units[i];
+    return NULL;
+}
+
+static uniform_t *ios_wo52_material_uniform(program_t *program,
+    const char *name)
+{
+    khint_t k;
+    size_t length;
+    if(!program || !program->uniform || !name)
+        return NULL;
+    length = strlen(name);
+    for(k = kh_begin(program->uniform); k != kh_end(program->uniform); ++k) {
+        uniform_t *uniform;
+        if(!kh_exist(program->uniform, k))
+            continue;
+        uniform = kh_value(program->uniform, k);
+        if(uniform && uniform->name && !strncmp(uniform->name, name, length) &&
+           (uniform->name[length] == '\0' || uniform->name[length] == '['))
+            return uniform;
+    }
+    return NULL;
+}
+
+static uniform_t *ios_wo52_material_uniform_location(program_t *program,
+    GLint location)
+{
+    khint_t k;
+    if(!program || !program->uniform || location < 0)
+        return NULL;
+    k = kh_get(uniformlist, program->uniform, location);
+    return k == kh_end(program->uniform) ? NULL : kh_value(program->uniform, k);
+}
+
+static void ios_wo52_material_summary(void)
+{
+    ios_wo49_emit(
+        "WO52 material trace summary: selected=%u cap=256 terminal=%u incomplete=%u overflow=%u pending=%u active=%llu replay=%u records_per_stage<=1 sink=engine-console mutation=none error_queue=untouched",
+        ios_wo52_material_count, ios_wo52_material_terminal_count,
+        ios_wo52_material_incomplete_count, ios_wo52_material_overflow,
+        ios_wo52_material_pending ? 1u : 0u, ios_wo52_material_active,
+        ios_wo52_material_replay.count);
+}
+
+static void ios_wo52_material_terminal(ios_wo52_material_record_t *record,
+    const char *result, const char *field)
+{
+    if(!record || record->terminal)
+        return;
+    record->terminal = 1;
+    if(ios_wo52_material_pending == record->token)
+        ios_wo52_material_pending = 0;
+    if(ios_wo52_material_active == record->token)
+        ios_wo52_material_active = 0;
+    ++ios_wo52_material_terminal_count;
+    if(strcmp(result, "incomplete/overflow") == 0)
+        ++ios_wo52_material_incomplete_count;
+    ios_wo49_emit(
+        "WO52 material trace terminal: token=%llu result=%s first_field=%s stages=0x%02x route=%s terminal=1 mutation=none error_queue=untouched",
+        record->token, result, field ? field : "none", record->stage_mask,
+        record->route[0] ? record->route : "unknown");
+    ios_wo52_material_summary();
+}
+
+static void ios_wo52_material_classify_native(ios_wo52_material_record_t *record)
+{
+    if(!(record->stage_mask & 0x04u)) {
+        ios_wo52_material_terminal(record, "incomplete/overflow", "bind-stage");
+        return;
+    }
+    if(!(record->stage_mask & 0x08u)) {
+        ios_wo52_material_terminal(record, "incomplete/overflow", "gl4es-route-stage");
+        return;
+    }
+    for(unsigned int i = 0; i < record->producer.unitCount; ++i) {
+        const ios_wo52_material_unit_desc_t *p = &record->producer.units[i];
+        const ios_wo52_material_cache_unit_t *c =
+            ios_wo52_material_cache_unit(record, p->unit);
+        GLuint expected_logical = p->mode == IOS_WO52_MODE_COLORMAP &&
+            record->engine[i].seen ? record->engine[i].after_logical :
+            p->logicalObject;
+        if(!p->ready || !p->engineObject || !p->logicalObject || !p->width || !p->height) {
+            ios_wo52_material_terminal(record, "producer/material selection mismatch",
+                "producer-object-readiness");
+            return;
+        }
+        if(c && c->requestedObject == (int)p->engineObject &&
+           c->afterObject != c->requestedObject) {
+            ios_wo52_material_terminal(record, "bind/cache skip mismatch",
+                "diffusion-cache-after-object");
+            return;
+        }
+        if(p->mode != IOS_WO52_MODE_COLORMAP && record->engine[i].seen &&
+           record->engine[i].after_index != p->engineObject) {
+            ios_wo52_material_terminal(record, "bind/cache skip mismatch",
+                "engine-cache-after-index");
+            return;
+        }
+        if(record->gl4es[i].seen &&
+           record->gl4es[i].logical != expected_logical) {
+            ios_wo52_material_terminal(record,
+                "GL4ES logical-to-native realization mismatch", "gl4es-bind-logical");
+            return;
+        }
+        if(p->unit < MAX_TEX) {
+            GLuint itarget = what_target(p->target);
+            gltexture_t *logical = glstate->texture.bound[p->unit][itarget];
+            int native_match = p->target == GL_TEXTURE_CUBE_MAP ?
+                (record->gl4es[i].seen &&
+                 logical && logical->glname == record->gl4es[i].native) :
+                (logical && logical->glname == glstate->actual_tex2d[p->unit]);
+            if(!logical || logical->texture != expected_logical || !native_match) {
+                ios_wo52_material_terminal(record,
+                    "GL4ES logical-to-native realization mismatch",
+                    !logical || logical->texture != expected_logical ?
+                    "logical-object" : "native-binding");
+                return;
+            }
+        }
+    }
+    program_t *program = glstate->gleshard->glprogram;
+    if(!program || glstate->glsl->program != record->producer.logicalProgram) {
+        ios_wo52_material_terminal(record, "sampler/program routing mismatch",
+            !program ? "native-program" : "logical-program");
+        return;
+    }
+    for(unsigned int i = 0; i < record->producer.unitCount; ++i) {
+        const ios_wo52_material_unit_desc_t *p = &record->producer.units[i];
+        if(p->samplerLocation < 0)
+            continue;
+        int found = -1;
+        if(program) {
+            for(int j = 0; j < MAX_TEX && program->texunits[j].type; ++j)
+                if(program->texunits[j].req_tu == (int)p->unit) {
+                    found = j;
+                    break;
+                }
+        }
+        uniform_t *sampler = found >= 0 ?
+            ios_wo52_material_uniform_location(program, program->texunits[found].id) : NULL;
+        GLenum expected_type = p->target == GL_TEXTURE_CUBE_MAP ?
+            GL_SAMPLER_CUBE : GL_SAMPLER_2D;
+        if(found < 0 || !sampler || sampler->type != expected_type ||
+           sampler->size != 1 || GetUniformi(program, sampler->id) != p->samplerValue) {
+            ios_wo52_material_terminal(record, "sampler/program routing mismatch",
+                found < 0 ? "reflected-sampler-unit" :
+                (!sampler ? "sampler-reflection" :
+                (sampler->type != expected_type ? "sampler-type" :
+                (sampler->size != 1 ? "sampler-extent" : "sampler-value"))));
+            return;
+        }
+    }
+    uniform_t *render_color = ios_wo52_material_uniform(program, "u_RenderColor");
+    if(record->producer.renderColorLocation >= 0 &&
+       (!render_color || render_color->type != GL_FLOAT_VEC4 ||
+        render_color->size != 1 || render_color->cache_size < 4 * (int)sizeof(GLfloat) ||
+        memcmp((char *)program->cache.cache + render_color->cache_offs,
+            record->producer.renderColor, 4 * sizeof(GLfloat)))) {
+        ios_wo52_material_terminal(record,
+            "texture/sampler chain matches but captured color/material/shader state differs",
+            "u_RenderColor");
+        return;
+    }
+    uniform_t *mesh_params = ios_wo52_material_uniform(program, "u_MeshParams");
+    if(record->producer.meshParamsLocation >= 0 &&
+       (!mesh_params || mesh_params->type != GL_FLOAT_VEC3 ||
+        mesh_params->size < 3 || mesh_params->cache_size < 9 * (int)sizeof(GLfloat) ||
+        memcmp((char *)program->cache.cache + mesh_params->cache_offs +
+            6 * sizeof(GLfloat), record->producer.meshParams,
+            3 * sizeof(GLfloat)))) {
+        ios_wo52_material_terminal(record,
+            "texture/sampler chain matches but captured color/material/shader state differs",
+            "u_MeshParams[2]");
+        return;
+    }
+    ios_wo52_material_terminal(record,
+        "texture/sampler chain matches but captured color/material/shader state differs",
+        "texture-sampler-chain");
+}
