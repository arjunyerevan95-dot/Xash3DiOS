diff --git a/client/render/r_opengl.cpp b/client/render/r_opengl.cpp
--- a/client/render/r_opengl.cpp
+++ b/client/render/r_opengl.cpp
@@ -21,6 +21,10 @@ Copyright (C) 2010 Uncle Mike
 #include "r_weather.h"
 #include "mathlib.h"
 
+#ifndef GL_MAX_ARRAY_TEXTURE_LAYERS_EXT
+#define GL_MAX_ARRAY_TEXTURE_LAYERS_EXT 0x88FF
+#endif
+
 #define MAX_RESERVED_UNIFORMS		22	// dynamic lighting estimates 42 uniforms... 
 
 glState_t		glState;
@@ -670,6 +670,21 @@ static void GL_InitExtensions( void )
 
 	// 2d texture array support
 	GL_CheckExtension( "GL_EXT_texture_array", NULL, "gl_texture_2d_array", R_TEXTURE_ARRAY_EXT, true );
+	if( GL_Support( R_TEXTURE_ARRAY_EXT ))
+	{
+		const bool callbacks = gRenderfuncs.GL_LoadTextureArray != NULL && gRenderfuncs.GL_CreateTextureArray != NULL;
+		pglGetIntegerv( GL_MAX_ARRAY_TEXTURE_LAYERS_EXT, &glConfig.max_2d_texture_layers );
+		if( glConfig.max_2d_texture_layers < MAX_LANDSCAPE_LAYERS || !callbacks )
+			GL_SetExtension( R_TEXTURE_ARRAY_EXT, false );
+	}
+
+	#if XASH_IOS
+	ALERT( at_console, "iOS production texture array admission: extension=%d callbacks=%d max_layers=%d minimum=%d terrain_shaders=full enabled=%d\n",
+		GL_Support( R_TEXTURE_ARRAY_EXT ) ? 1 : 0,
+		( gRenderfuncs.GL_LoadTextureArray != NULL && gRenderfuncs.GL_CreateTextureArray != NULL ) ? 1 : 0,
+		glConfig.max_2d_texture_layers, MAX_LANDSCAPE_LAYERS,
+		GL_Support( R_TEXTURE_ARRAY_EXT ) ? 1 : 0 );
+	#endif
 
 	if( !GL_Support( R_TEXTURE_ARRAY_EXT ))
 		ALERT( at_warning, "GL_EXT_texture_array not supported. Landscapes will be unavailable\n" );
