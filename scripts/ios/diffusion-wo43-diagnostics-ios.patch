+#if XASH_IOS
+typedef struct wo43_diagnostics_s
+{
+	unsigned int frame;
+	unsigned int phaseErrors;
+	unsigned int staleErrors;
+	unsigned int sceneMask;
+	unsigned int worldSubmissions;
+	unsigned int brushSubmissions;
+	unsigned int studioSubmissions;
+	unsigned int shaderHits;
+	unsigned int shaderMisses;
+	unsigned int shaderTranslations;
+	unsigned int shaderCompiles;
+	unsigned int shaderLinks;
+	unsigned int foliageConstructed;
+	unsigned int foliageDuplicates;
+	double shaderLookupSeconds;
+	double shaderTranslateSeconds;
+	double shaderCompileSeconds;
+	double shaderLinkSeconds;
+	double foliageSeconds;
+	bool active;
+	bool exactErrorAttributed;
+} wo43_diagnostics_t;
+
+static wo43_diagnostics_t wo43;
+
+static void WO43_ReadState( GLint *framebuffer, GLint *renderbuffer, GLuint *program )
+{
+	unsigned int drained = 0;
+	*framebuffer = *renderbuffer = 0;
+	*program = RI->currentshader ? RI->currentshader->handle : 0;
+	pglGetIntegerv( GL_FRAMEBUFFER_BINDING_EXT, framebuffer );
+	pglGetIntegerv( GL_RENDERBUFFER_BINDING_EXT, renderbuffer );
+	while( drained < 8 && pglGetError() != GL_NO_ERROR )
+	{
+		// Do not let diagnostic state queries leak into the audited interval.
+		drained++;
+	}
+}
+
+void WO43_BeginFrame( unsigned int frame )
+{
+	GLenum error;
+	unsigned int drained = 0;
+	unsigned int first = GL_NO_ERROR;
+
+	wo43.frame = frame;
+	wo43.phaseErrors = 0;
+	wo43.sceneMask = 0;
+	wo43.worldSubmissions = 0;
+	wo43.brushSubmissions = 0;
+	wo43.studioSubmissions = 0;
+	wo43.active = frame > 0 && frame <= 12 && !wo43.exactErrorAttributed;
+
+	if( !wo43.active )
+		return;
+
+	while( drained < 32 && ( error = pglGetError() ) != GL_NO_ERROR )
+	{
+		if( drained == 0 ) first = error;
+		drained++;
+	}
+	wo43.staleErrors += drained;
+	ALERT( at_console, "WO43 GL interval begin: frame=%u queue=%s drained=%u first=0x%04x bound=32\n",
+		frame, drained ? "nonempty" : "empty", drained, first );
+}
+
+void WO43_GLPhaseFence( const char *site, const char *function, const char *file, int line )
+{
+	GLenum error;
+	GLint framebuffer, renderbuffer;
+	GLuint program;
+
+	if( !wo43.active || wo43.exactErrorAttributed || wo43.phaseErrors )
+		return;
+
+	error = pglGetError();
+	if( error == GL_NO_ERROR )
+		return;
+
+	WO43_ReadState( &framebuffer, &renderbuffer, &program );
+	wo43.phaseErrors++;
+	ALERT( at_console, "WO43 GL phase transition: frame=%u site=%s function=%s file=%s line=%d first_error=0x%04x fb=%d rb=%d program=%u\n",
+		wo43.frame, site, function, file, line, error, framebuffer, renderbuffer, program );
+}
+
+void WO43_GLCallSite( const char *site, const char *function, const char *file, int line, const char *api, const char *args )
+{
+	GLenum error;
+	GLint framebuffer, renderbuffer;
+	GLuint program;
+
+	if( !wo43.active || wo43.exactErrorAttributed )
+		return;
+
+	error = pglGetError();
+	if( error == GL_NO_ERROR )
+		return;
+
+	WO43_ReadState( &framebuffer, &renderbuffer, &program );
+	wo43.exactErrorAttributed = true;
+	ALERT( at_console, "WO43 GL exact first failure: frame=%u site=%s function=%s file=%s line=%d api=%s args=%s error=0x%04x fb=%d rb=%d program=%u tracer=stopped\n",
+		wo43.frame, site, function, file, line, api, args, error, framebuffer, renderbuffer, program );
+}
+
+void WO43_PhaseDuration( const char *phase, double duration )
+{
+	if( wo43.active && duration > 0.250 )
+		ALERT( at_console, "WO43 init gap: frame=%u phase=%s duration=%.3f threshold=0.250 source=instrumented\n",
+			wo43.frame, phase, duration );
+}
+
+void WO43_ShaderLookup( bool hit, double duration )
+{
+	if( hit ) wo43.shaderHits++;
+	else wo43.shaderMisses++;
+	wo43.shaderLookupSeconds += duration;
+	WO43_PhaseDuration( hit ? "shader-cache-hit" : "shader-cache-miss", duration );
+}
+
+void WO43_ShaderTranslate( double duration )
+{
+	wo43.shaderTranslations++;
+	wo43.shaderTranslateSeconds += duration;
+	WO43_PhaseDuration( "shader-translation", duration );
+}
+
+void WO43_ShaderCompile( double duration )
+{
+	wo43.shaderCompiles++;
+	wo43.shaderCompileSeconds += duration;
+	WO43_PhaseDuration( "shader-compile", duration );
+}
+
+void WO43_ShaderLink( double duration )
+{
+	wo43.shaderLinks++;
+	wo43.shaderLinkSeconds += duration;
+	WO43_PhaseDuration( "shader-link", duration );
+}
+
+void WO43_FoliageConstructed( double duration )
+{
+	wo43.foliageConstructed++;
+	wo43.foliageSeconds += duration;
+	WO43_PhaseDuration( "foliage-construction", duration );
+}
+
+void WO43_FoliageDuplicateAvoided( void )
+{
+	wo43.foliageDuplicates++;
+}
+
+void WO43_RecordSubmission( unsigned int mask, unsigned int count )
+{
+	wo43.sceneMask |= mask;
+	if( mask == 1 ) wo43.worldSubmissions += count;
+	if( mask == 2 ) wo43.brushSubmissions += count;
+	if( mask == 4 ) wo43.studioSubmissions += count;
+}
+
+void WO43_EndFrame( void )
+{
+	CVAR_SET_FLOAT( "wo43_scene_submission", (float)wo43.sceneMask );
+	if( wo43.frame == 0 || wo43.frame > 12 )
+		return;
+	ALERT( at_console, "WO43 init heartbeat: frame=%u scene_mask=0x%x world=%u brush=%u studio=%u shader_hit=%u miss=%u translate=%u/%.3fs compile=%u/%.3fs link=%u/%.3fs foliage_construct=%u/%.3fs duplicate_avoided=%u phase_errors=%u stale_drained=%u exact=%d\n",
+		wo43.frame, wo43.sceneMask, wo43.worldSubmissions, wo43.brushSubmissions,
+		wo43.studioSubmissions, wo43.shaderHits, wo43.shaderMisses,
+		wo43.shaderTranslations, wo43.shaderTranslateSeconds, wo43.shaderCompiles,
+		wo43.shaderCompileSeconds, wo43.shaderLinks, wo43.shaderLinkSeconds,
+		wo43.foliageConstructed, wo43.foliageSeconds, wo43.foliageDuplicates,
+		wo43.phaseErrors, wo43.staleErrors, wo43.exactErrorAttributed );
+}
+#endif
