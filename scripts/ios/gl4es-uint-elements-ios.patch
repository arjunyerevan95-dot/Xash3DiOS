+    IOS_UINT_ROUTE_BASEVERTEX = 1u<<2,
+    IOS_UINT_ROUTE_INSTANCED = 1u<<3,
+    IOS_UINT_ROUTE_MULTIDRAW = 1u<<4,
+    IOS_UINT_ROUTE_RENDERLIST = 1u<<5,
+    IOS_UINT_ROUTE_INTERCEPT = 1u<<6
+};
+
+static const GLvoid *resolved_element_indices(const GLvoid *indices)
+{
+    return glstate->vao->elements
+        ? (const GLvoid*)((const char*)glstate->vao->elements->data + (uintptr_t)indices)
+        : indices;
+}
+
+static int require_uint_element_support(GLenum type, const char *route)
+{
+    static int logged_reject = 0;
+    if(type!=GL_UNSIGNED_INT || hardext.elementuint)
+        return 1;
+    if(!logged_reject) {
+        LOGE("iOS uint element first use: route=%s rejected=unsupported-es2 error=GL_INVALID_OPERATION\n", route);
+        logged_reject = 1;
+    }
+    errorShim(GL_INVALID_OPERATION);
+    return 0;
+}
+
+static void trace_uint_element_route(const char *route, unsigned route_bit, const GLuint *indices, GLsizei count, int deferred)
+{
+    static unsigned seen_routes = 0;
+    static unsigned seen_high = 0;
+    GLuint max = 0;
+    if(!indices || count<=0) return;
+    for(int i=0; i<count; ++i)
+        if(indices[i]>max) max=indices[i];
+    if(!(seen_routes&route_bit)) {
+        LOGD("iOS uint element first use: route=%s source=%s storage=%s submitted=GL_UNSIGNED_INT max=%u\n",
+            route, glstate->vao->elements?"ebo-offset":"client", deferred?"renderlist-uint32":"direct-uint32", max);
+        seen_routes |= route_bit;
+        LOGD("iOS uint element route summary: mask=0x%02x ordinary=%d range=%d basevertex=%d instanced=%d multidraw=%d renderlist=%d intercept=%d\n",
+            seen_routes,
+            !!(seen_routes&IOS_UINT_ROUTE_ORDINARY), !!(seen_routes&IOS_UINT_ROUTE_RANGE),
+            !!(seen_routes&IOS_UINT_ROUTE_BASEVERTEX), !!(seen_routes&IOS_UINT_ROUTE_INSTANCED),
+            !!(seen_routes&IOS_UINT_ROUTE_MULTIDRAW), !!(seen_routes&IOS_UINT_ROUTE_RENDERLIST),
+            !!(seen_routes&IOS_UINT_ROUTE_INTERCEPT));
+    }
+    if(max>65535 && !(seen_high&route_bit)) {
+        LOGD("iOS uint element high index: route=%s source=%s max=%u submitted=GL_UNSIGNED_INT\n",
+            route, glstate->vao->elements?"ebo-offset":"client", max);
+        seen_high |= route_bit;
+    }
+}
+
+static void prepare_element_indices(GLenum type, const GLvoid *indices, GLsizei count,
+    int list_path, int force_copy, GLushort **sindices, GLuint **iindices,
+    int *owned, GLuint *old_index)
+{
+    const GLvoid *src = resolved_element_indices(indices);
+    *sindices = NULL;
+    *iindices = NULL;
+    *owned = 0;
+    *old_index = 0;
+    if(list_path || force_copy) {
+        const GLenum target = (list_path || type==GL_UNSIGNED_INT)?GL_UNSIGNED_INT:GL_UNSIGNED_SHORT;
+        GLvoid *copy = copy_gl_array(src, type, 1, 0, target, 1, 0, count, NULL);
+        if(target==GL_UNSIGNED_INT) *iindices = copy;
+        else *sindices = copy;
+        *owned = 1;
+        *old_index = wantBufferIndex(0);
+    } else if(type==GL_UNSIGNED_INT) {
+        *iindices = (GLuint*)src;
+    } else if(type==GL_UNSIGNED_SHORT) {
+        *sindices = (GLushort*)src;
+    } else {
+        *sindices = copy_gl_array(src, type, 1, 0, GL_UNSIGNED_SHORT, 1, 0, count, NULL);
+        *owned = 1;
+        *old_index = wantBufferIndex(0);
+    }
+}
+
+static void release_element_indices(GLushort *sindices, GLuint *iindices, int owned, GLuint old_index)
+{
+    if(!owned) return;
+    free(iindices?(void*)iindices:(void*)sindices);
+    wantBufferIndex(old_index);
+}
