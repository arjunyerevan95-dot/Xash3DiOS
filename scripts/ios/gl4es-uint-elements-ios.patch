index 3e703b35..9944eaaf 100644
--- a/src/glx/hardext.c
+++ b/src/glx/hardext.c
@@ -332 +332,17 @@ void GetHardwareExtensions(int notest)
-    S("GL_OES_element_index_uint ", elementuint, 1);
+    // GL_UNSIGNED_INT element indices are core in native OpenGL ES 3.x.
+    // Some ES3 drivers correctly omit the legacy OES token, so use the live
+    // context version as the authority and retain extension gating for ES2.
+    int native_es_major = 0;
+    if(Version) {
+        const char *p = strstr(Version, "OpenGL ES");
+        if(p) {
+            p += strlen("OpenGL ES");
+            while(*p && (*p<'0' || *p>'9')) ++p;
+            if(*p>='0' && *p<='9') native_es_major = *p-'0';
+        }
+    }
+    const int elementuint_extension = (Exts && strstr(Exts, "GL_OES_element_index_uint "))?1:0;
+    hardext.elementuint = (native_es_major>=3 || elementuint_extension)?1:0;
+    SHUT_LOGD("iOS uint element policy: version=\"%s\" native_es_major=%d extension=%d enabled=%d reason=%s\n",
+        Version?Version:"(null)", native_es_major, elementuint_extension, hardext.elementuint,
+        (native_es_major>=3)?"native-es3-core":(elementuint_extension?"oes-extension":"unsupported"));
