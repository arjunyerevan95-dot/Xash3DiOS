+static void GL_AssignSamplerUnit( glsl_program_t *shader, GLint location,
+	const char *sampler, GLint unit )
+{
+#if defined( XASH_IOS )
+	static bool policy_reported = false;
+	static unsigned int rejected_uploads = 0;
+
+	if( !policy_reported )
+	{
+		ALERT( at_aiconsole, "iOS inactive sampler policy: active location 0 preserved; missing=-1; negative uploads skipped\n" );
+		policy_reported = true;
+	}
+
+	if( location < 0 )
+	{
+		if( rejected_uploads < 16 )
+		{
+			ALERT( at_aiconsole, "iOS inactive sampler rejection: program=%s sampler=%s unit=%d location=%d upload=skipped\n",
+				shader ? shader->name : "<none>", sampler ? sampler : "<none>", unit, location );
+			rejected_uploads++;
+		}
+		return;
+	}
+#endif
+	pglUniform1iARB( location, unit );
+}
