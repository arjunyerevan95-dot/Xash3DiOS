diff --git a/client/render/view.cpp b/client/render/view.cpp
--- a/client/render/view.cpp
+++ b/client/render/view.cpp
@@ -2419,0 +2420,44 @@ void V_CalcRefdef( struct ref_params_s *pparams )
+	if( !g_fRenderInitialized )
+	{
+		static bool fallback_announced;
+		cl_entity_t *view = GET_VIEWMODEL();
+
+		if( !fallback_announced )
+		{
+			gEngfuncs.Con_Printf( "Using engine-safe view calculation.\n" );
+			fallback_announced = true;
+		}
+
+		g_fFrametime = pparams->frametime;
+		pause = pparams->paused;
+
+		pparams->vieworg.x = pparams->simorg.x + pparams->viewheight.x + 0.03125f;
+		pparams->vieworg.y = pparams->simorg.y + pparams->viewheight.y + 0.03125f;
+		pparams->vieworg.z = pparams->simorg.z + pparams->viewheight.z + 0.03125f;
+		pparams->viewangles.x = pparams->cl_viewangles.x + pparams->punchangle.x;
+		pparams->viewangles.y = pparams->cl_viewangles.y + pparams->punchangle.y;
+		pparams->viewangles.z = pparams->cl_viewangles.z + pparams->punchangle.z;
+
+		AngleVectors( pparams->cl_viewangles, pparams->forward, pparams->right, pparams->up );
+
+		if( view )
+		{
+			view->origin.x = pparams->vieworg.x;
+			view->origin.y = pparams->vieworg.y;
+			view->origin.z = pparams->vieworg.z;
+			view->angles.x = pparams->cl_viewangles.x;
+			view->angles.y = pparams->cl_viewangles.y;
+			view->angles.z = pparams->cl_viewangles.z;
+		}
+
+		v_origin.x = pparams->vieworg.x;
+		v_origin.y = pparams->vieworg.y;
+		v_origin.z = pparams->vieworg.z;
+		v_angles.x = pparams->viewangles.x;
+		v_angles.y = pparams->viewangles.y;
+		v_angles.z = pparams->viewangles.z;
+		v_cl_angles.x = pparams->cl_viewangles.x;
+		v_cl_angles.y = pparams->cl_viewangles.y;
+		v_cl_angles.z = pparams->cl_viewangles.z;
+		return;
+	}
diff --git a/client/render/r_shader.cpp b/client/render/r_shader.cpp
--- a/client/render/r_shader.cpp
+++ b/client/render/r_shader.cpp
@@ -271,0 +272,3 @@ static bool GL_ProcessShader( const char *filename, CVirtualFS *out, bool compat
+	#if XASH_IOS
+	out->Printf( "#define XASH_MOBILE_GLES 1\n" );
+	#endif
@@ -286 +289,24 @@ static bool GL_ProcessShader( const char *filename, CVirtualFS *out, bool compat
-	if( defines ) out->Print( defines );
+	if( defines )
+	{
+	#if XASH_IOS
+		char mobileDefines[MAX_OPTIONS_LENGTH];
+		char *line, *next;
+
+		Q_strncpy( mobileDefines, defines, sizeof( mobileDefines ) );
+		for( line = mobileDefines; line && *line; line = next )
+		{
+			next = Q_strchr( line, '\n' );
+			if( next ) *next++ = '\0';
+
+			if( Q_stristr( line, "MULTI_LAYERS" ) ||
+				Q_stristr( line, "EMBOSS" ) ||
+				Q_stristr( line, "HAS_SHADOWS" ) ||
+				Q_stristr( line, "INTERIOR" ) )
+				continue;
+
+			out->Printf( "%s\n", line );
+		}
+	#else
+		out->Print( defines );
+	#endif
+	}
@@ -2977,0 +3004,5 @@ void GL_InitGPUShaders( void )
+	#if !XASH_IOS
+	// Desktop post-processing requires GLSL features that GL4ES currently
+	// translates to an ES 1.00 target on iOS. Keep the mobile renderer profile
+	// intentionally limited to the core scene shaders until that translator has
+	// a real ES 3.x path.
@@ -3071,0 +3103,3 @@ void GL_InitGPUShaders( void )
+	#else
+	ALERT( at_console, "iOS mobile renderer profile: desktop post-processing shaders disabled\n" );
+	#endif
