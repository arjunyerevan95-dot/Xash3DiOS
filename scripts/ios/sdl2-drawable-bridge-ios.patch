diff --git a/src/video/uikit/SDL_uikitopengles.h b/src/video/uikit/SDL_uikitopengles.h
index 0533f69..dee2374 100644
--- a/src/video/uikit/SDL_uikitopengles.h
+++ b/src/video/uikit/SDL_uikitopengles.h
@@ -27,0 +28,70 @@
+#define SDL_XASH_IOS_DRAWABLE_BRIDGE_VERSION 2
+#define SDL_XASH_IOS_DRAWABLE_BRIDGE_RENDERER_HANDOFF 1
+#define SDL_XASH_IOS_DRAWABLE_BRIDGE_SDL_SWAP_ENTRY 2
+#define SDL_XASH_IOS_DRAWABLE_BRIDGE_SDL_POST_RESOLVE 3
+#define SDL_XASH_IOS_DRAWABLE_BRIDGE_PRE_PRESENT 4
+#define SDL_XASH_IOS_DRAWABLE_BRIDGE_PRESENT_BEFORE 5
+#define SDL_XASH_IOS_DRAWABLE_BRIDGE_POST_PRESENT 6
+
+typedef struct SDL_XASH_IOSDrawableBridgeState
+{
+    Uint32 version;
+    Uint32 size;
+    Uint64 context;
+    Uint64 currentContext;
+    Uint32 contextMatches;
+    Uint32 targetFramebuffer;
+    Uint32 targetRenderbuffer;
+    Uint32 drawableWidth;
+    Uint32 drawableHeight;
+    Uint32 sourceFramebuffer;
+    Uint32 sourceTexture;
+    Uint32 sourceRenderbuffer;
+    Uint32 logicalFramebuffer;
+    Uint32 targetStatus;
+    Uint32 transferAttempted;
+    Uint32 transferResult;
+    Uint32 proofSample;
+    Uint32 checksumBeforeValid;
+    Uint32 checksumBefore;
+    Uint32 checksumAfterValid;
+    Uint32 checksumAfter;
+    Uint32 checksumChanged;
+    Uint32 presentAttempted;
+    Uint32 presentResult;
+    Uint32 restoredFramebuffer;
+    Uint32 restoredRenderbuffer;
+    Uint32 restoredLogicalFramebuffer;
+    Uint32 restoreResult;
+    Uint32 failureCode;
+    Uint64 invocation;
+    Uint64 timestampUsec;
+    Uint64 hostTimeUsec;
+    Uint64 clientTimeUsec;
+    Uint32 checkpoint;
+    Uint32 auditSample;
+    Uint32 enginePhase;
+    Uint32 clientState;
+    char mapName[64];
+    Uint32 contextAPI;
+    Uint32 contextGeneration;
+    Uint32 resizeGeneration;
+    Uint32 viewFramebuffer;
+    Uint32 viewRenderbuffer;
+    Uint32 msaaFramebuffer;
+    Uint32 msaaRenderbuffer;
+    Uint32 depthRenderbuffer;
+    Uint32 requestedSamples;
+    Uint32 effectiveSamples;
+    Uint32 preconditionMask;
+    Uint32 queryFailureOperation;
+    Uint32 queryFailureError;
+} SDL_XASH_IOSDrawableBridgeState;
+
+typedef int (SDLCALL *SDL_XASH_IOSDrawableBridgeCallback)(int action,
+                                                           void *state,
+                                                           size_t stateSize);
+
+extern DECLSPEC int SDLCALL SDL_XASH_IOSSetDrawableBridgeCallback(
+    SDL_XASH_IOSDrawableBridgeCallback callback);
+
diff --git a/src/video/uikit/SDL_uikitopenglview.m b/src/video/uikit/SDL_uikitopenglview.m
index c36f060..e4345ce 100644
--- a/src/video/uikit/SDL_uikitopenglview.m
+++ b/src/video/uikit/SDL_uikitopenglview.m
@@ -24,0 +25 @@
+#include <stdint.h>
@@ -27,0 +29 @@
+#include "SDL_uikitopengles.h"
@@ -29,0 +32,10 @@
+static SDL_XASH_IOSDrawableBridgeCallback xashDrawableBridgeCallback;
+static Uint32 xashBridgeContextGenerationCounter;
+
+DECLSPEC int SDLCALL SDL_XASH_IOSSetDrawableBridgeCallback(
+    SDL_XASH_IOSDrawableBridgeCallback callback)
+{
+    xashDrawableBridgeCallback = callback;
+    return 0;
+}
+
@@ -48,0 +61,4 @@
+
+    int requestedSamples;
+    Uint32 xashContextGeneration;
+    Uint32 xashResizeGeneration;
@@ -79,0 +96 @@
+        requestedSamples = multisamples;
@@ -81,0 +99,2 @@
+        xashContextGeneration = ++xashBridgeContextGenerationCounter;
+        xashResizeGeneration = 1;
@@ -250,0 +270 @@
+    ++xashResizeGeneration;
@@ -281,0 +302,29 @@
+    SDL_XASH_IOSDrawableBridgeState bridge;
+    const BOOL bridgeRegistered = xashDrawableBridgeCallback != NULL;
+
+    SDL_zero(bridge);
+    bridge.version = SDL_XASH_IOS_DRAWABLE_BRIDGE_VERSION;
+    bridge.size = sizeof(bridge);
+    bridge.context = (Uint64)(uintptr_t)context;
+    bridge.currentContext = (Uint64)(uintptr_t)[EAGLContext currentContext];
+    bridge.contextMatches = context && [EAGLContext currentContext] == context;
+    bridge.contextAPI = (Uint32)context.API;
+    bridge.contextGeneration = xashContextGeneration;
+    bridge.resizeGeneration = xashResizeGeneration;
+    bridge.targetFramebuffer = viewFramebuffer;
+    bridge.targetRenderbuffer = viewRenderbuffer;
+    bridge.viewFramebuffer = viewFramebuffer;
+    bridge.viewRenderbuffer = viewRenderbuffer;
+    bridge.msaaFramebuffer = msaaFramebuffer;
+    bridge.msaaRenderbuffer = msaaRenderbuffer;
+    bridge.depthRenderbuffer = depthRenderbuffer;
+    bridge.requestedSamples = (Uint32)SDL_max(0, requestedSamples);
+    bridge.effectiveSamples = (Uint32)SDL_max(0, samples);
+    bridge.drawableWidth = backingWidth;
+    bridge.drawableHeight = backingHeight;
+
+    if (bridgeRegistered) {
+        xashDrawableBridgeCallback(SDL_XASH_IOS_DRAWABLE_BRIDGE_SDL_SWAP_ENTRY,
+                                   &bridge, sizeof(bridge));
+    }
+
@@ -310,0 +360,13 @@
+    if (bridgeRegistered) {
+        xashDrawableBridgeCallback(SDL_XASH_IOS_DRAWABLE_BRIDGE_SDL_POST_RESOLVE,
+                                   &bridge, sizeof(bridge));
+        xashDrawableBridgeCallback(SDL_XASH_IOS_DRAWABLE_BRIDGE_PRE_PRESENT,
+                                   &bridge, sizeof(bridge));
+
+        /* SDL owns the CAEAGLLayer color renderbuffer. Make it the explicit
+         * presentable object after GL4ES has filled the view framebuffer. */
+        glBindRenderbuffer(GL_RENDERBUFFER, viewRenderbuffer);
+        xashDrawableBridgeCallback(SDL_XASH_IOS_DRAWABLE_BRIDGE_PRESENT_BEFORE,
+                                   &bridge, sizeof(bridge));
+    }
+
@@ -314 +376,7 @@
-    [context presentRenderbuffer:GL_RENDERBUFFER];
+    bridge.presentAttempted = 1;
+    bridge.presentResult = [context presentRenderbuffer:GL_RENDERBUFFER];
+
+    if (bridgeRegistered) {
+        xashDrawableBridgeCallback(SDL_XASH_IOS_DRAWABLE_BRIDGE_POST_PRESENT,
+                                   &bridge, sizeof(bridge));
+    }
