--- a/src/video/uikit/SDL_uikitopenglview.m
+++ b/src/video/uikit/SDL_uikitopenglview.m
@@ -26,0 +27 @@
+#include <stdint.h>
@@ -27,0 +29 @@
+#include "SDL_uikitopengles.h"
@@ -29,0 +32,10 @@
+static SDL_XASH_IOSDirectDrawableCallback xashDirectDrawableCallback;
+static Uint32 xashDirectDrawableContextCounter;
+
+DECLSPEC int SDLCALL SDL_XASH_IOSSetDirectDrawableCallback(
+    SDL_XASH_IOSDirectDrawableCallback callback)
+{
+    xashDirectDrawableCallback = callback;
+    return 0;
+}
+
@@ -46,0 +59,4 @@
+    int requestedSamples;
+
+    Uint32 xashContextGeneration;
+    Uint32 xashResizeGeneration;
@@ -80,0 +97,3 @@
+        requestedSamples = multisamples;
+        xashContextGeneration = ++xashDirectDrawableContextCounter;
+        xashResizeGeneration = 1;
@@ -250,0 +270,32 @@
+    ++xashResizeGeneration;
+}
+
+- (void)xashFillDirectDrawable:(SDL_XASH_IOSDirectDrawableState *)state
+                         action:(int)action
+{
+    SDL_zero(*state);
+    state->version = SDL_XASH_IOS_DIRECT_DRAWABLE_VERSION;
+    state->size = sizeof(*state);
+    state->context = (Uint64)(uintptr_t)context;
+    state->currentContext = (Uint64)(uintptr_t)[EAGLContext currentContext];
+    state->contextMatches = context && [EAGLContext currentContext] == context;
+    state->contextAPI = (Uint32)context.API;
+    state->contextGeneration = xashContextGeneration;
+    state->resizeGeneration = xashResizeGeneration;
+    state->viewFramebuffer = viewFramebuffer;
+    state->viewRenderbuffer = viewRenderbuffer;
+    state->drawableWidth = backingWidth;
+    state->drawableHeight = backingHeight;
+    state->requestedSamples = (Uint32)SDL_max(0, requestedSamples);
+    state->effectiveSamples = (Uint32)SDL_max(0, samples);
+    state->action = (Uint32)action;
+}
+
+- (void)xashNotifyDirectDrawable:(int)action
+{
+    SDL_XASH_IOSDirectDrawableState state;
+    if (!xashDirectDrawableCallback) {
+        return;
+    }
+    [self xashFillDirectDrawable:&state action:action];
+    xashDirectDrawableCallback(action, &state, sizeof(state));
@@ -281,0 +333,9 @@
+    SDL_XASH_IOSDirectDrawableState state;
+    const BOOL callbackRegistered = xashDirectDrawableCallback != NULL;
+
+    [self xashFillDirectDrawable:&state action:SDL_XASH_IOS_DIRECT_DRAWABLE_SWAP_ENTRY];
+    if (callbackRegistered) {
+        xashDirectDrawableCallback(SDL_XASH_IOS_DIRECT_DRAWABLE_SWAP_ENTRY,
+                                   &state, sizeof(state));
+    }
+
@@ -311,4 +371,15 @@
-    /* viewRenderbuffer should always be bound here. Code that binds something
-     * else is responsible for rebinding viewRenderbuffer, to reduce duplicate
-     * state changes. */
-    [context presentRenderbuffer:GL_RENDERBUFFER];
+    /* SDL owns the CAEAGLLayer renderbuffer. Bind it explicitly so presentation
+     * never depends on a renderer's last renderbuffer binding. */
+    glBindRenderbuffer(GL_RENDERBUFFER, viewRenderbuffer);
+    state.action = SDL_XASH_IOS_DIRECT_DRAWABLE_PRESENT_BEFORE;
+    if (callbackRegistered) {
+        xashDirectDrawableCallback(SDL_XASH_IOS_DIRECT_DRAWABLE_PRESENT_BEFORE,
+                                   &state, sizeof(state));
+    }
+    state.presentAttempted = 1;
+    state.presentResult = [context presentRenderbuffer:GL_RENDERBUFFER];
+    state.action = SDL_XASH_IOS_DIRECT_DRAWABLE_POST_PRESENT;
+    if (callbackRegistered) {
+        xashDirectDrawableCallback(SDL_XASH_IOS_DIRECT_DRAWABLE_POST_PRESENT,
+                                   &state, sizeof(state));
+    }
@@ -334,0 +406 @@
+        [self xashNotifyDirectDrawable:SDL_XASH_IOS_DIRECT_DRAWABLE_RESIZED];
@@ -372,0 +445 @@
+        [self xashNotifyDirectDrawable:SDL_XASH_IOS_DIRECT_DRAWABLE_DESTROYING];
