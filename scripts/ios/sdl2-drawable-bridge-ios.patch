@@ -27,0 +28,44 @@
+#define SDL_XASH_IOS_DRAWABLE_BRIDGE_VERSION 1
+#define SDL_XASH_IOS_DRAWABLE_BRIDGE_PRE_PRESENT 1
+#define SDL_XASH_IOS_DRAWABLE_BRIDGE_POST_PRESENT 2
+
+typedef struct SDL_XASH_IOSDrawableBridgeState
+{
+    Uint32 version;
+    Uint32 size;
+    Uint64 context;
+    Uint64 currentContext;
+    Uint32 contextMatches;
+    Uint32 targetFramebuffer;
+    Uint32 targetRenderbuffer;
+    Uint32 drawableWidth;
+    Uint32 drawableHeight;
+    Uint32 sourceFramebuffer;
+    Uint32 sourceTexture;
+    Uint32 sourceRenderbuffer;
+    Uint32 logicalFramebuffer;
+    Uint32 targetStatus;
+    Uint32 transferAttempted;
+    Uint32 transferResult;
+    Uint32 proofSample;
+    Uint32 checksumBeforeValid;
+    Uint32 checksumBefore;
+    Uint32 checksumAfterValid;
+    Uint32 checksumAfter;
+    Uint32 checksumChanged;
+    Uint32 presentAttempted;
+    Uint32 presentResult;
+    Uint32 restoredFramebuffer;
+    Uint32 restoredRenderbuffer;
+    Uint32 restoredLogicalFramebuffer;
+    Uint32 restoreResult;
+    Uint32 failureCode;
+} SDL_XASH_IOSDrawableBridgeState;
+
+typedef int (SDLCALL *SDL_XASH_IOSDrawableBridgeCallback)(int action,
+                                                           void *state,
+                                                           size_t stateSize);
+
+extern DECLSPEC int SDLCALL SDL_XASH_IOSSetDrawableBridgeCallback(
+    SDL_XASH_IOSDrawableBridgeCallback callback);
