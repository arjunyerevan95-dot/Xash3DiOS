index 0533f69..9534cbf 100644
--- a/src/video/uikit/SDL_uikitopengles.h
+++ b/src/video/uikit/SDL_uikitopengles.h
@@ -27,0 +28,40 @@
+#define SDL_XASH_IOS_DIRECT_DRAWABLE_VERSION 3
+#define SDL_XASH_IOS_DIRECT_DRAWABLE_CONTEXT_RESTORED 1
+#define SDL_XASH_IOS_DIRECT_DRAWABLE_RESIZED 2
+#define SDL_XASH_IOS_DIRECT_DRAWABLE_SWAP_ENTRY 3
+#define SDL_XASH_IOS_DIRECT_DRAWABLE_PRESENT_BEFORE 4
+#define SDL_XASH_IOS_DIRECT_DRAWABLE_POST_PRESENT 5
+#define SDL_XASH_IOS_DIRECT_DRAWABLE_DESTROYING 6
+
+typedef struct SDL_XASH_IOSDirectDrawableState
+{
+    Uint32 version;
+    Uint32 size;
+    Uint64 context;
+    Uint64 currentContext;
+    Uint32 contextMatches;
+    Uint32 contextAPI;
+    Uint32 contextGeneration;
+    Uint32 resizeGeneration;
+    Uint32 viewFramebuffer;
+    Uint32 viewRenderbuffer;
+    Uint32 drawableWidth;
+    Uint32 drawableHeight;
+    Uint32 requestedSamples;
+    Uint32 effectiveSamples;
+    Uint32 action;
+    Uint32 presentAttempted;
+    Uint32 presentResult;
+    Uint64 invocation;
+    Uint32 enginePhase;
+    Uint32 clientState;
+    char mapName[64];
+} SDL_XASH_IOSDirectDrawableState;
+
+typedef int (SDLCALL *SDL_XASH_IOSDirectDrawableCallback)(int action,
+                                                           void *state,
+                                                           size_t stateSize);
+
+extern DECLSPEC int SDLCALL SDL_XASH_IOSSetDirectDrawableCallback(
+    SDL_XASH_IOSDirectDrawableCallback callback);
+
