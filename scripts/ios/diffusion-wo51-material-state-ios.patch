 	pglUseProgramObjectARB( GL_NONE );
 }
 
+static int GL_ActiveUniformExtent( glsl_program_t *shader, const char *wantedName, GLenum wantedType )
+{
+	int count = 0;
+	char uniformName[256];
+
+	if( !shader || !wantedName )
+		return 0;
+
+	pglGetObjectParameterivARB( shader->handle, GL_OBJECT_ACTIVE_UNIFORMS_ARB, &count );
+	for( int i = 0; i < count; i++ )
+	{
+		GLint size = 0;
+		GLenum type = 0;
+		pglGetActiveUniformARB( shader->handle, i, sizeof( uniformName ), NULL, &size, &type, uniformName );
+		char *array = Q_strchr( uniformName, '[' );
+		if( array ) *array = '\0';
+		if( !Q_stricmp( uniformName, wantedName ) )
+			return type == wantedType ? size : 0;
+	}
+
+	return 0;
+}
+
 void GL_BindShader( glsl_program_t *shader )
 {
 	if( !shader && RI->currentshader )
@@ -1297,6 +1320,14 @@ static void GL_InitSolidStudioUniforms( glsl_program_t *shader )
 
 	shader->u_RenderColor = pglGetUniformLocationARB( shader->handle, "u_RenderColor" );
 	shader->u_StudioParams = pglGetUniformLocationARB( shader->handle, "u_StudioParams" );
+	shader->studio_params_count = GL_FindShaderDirective( shader, "STUDIO_ADDITIVE" ) ?
+		( GL_FindShaderDirective( shader, "STUDIO_HAS_CHROME" ) ? 2 : 1 ) : 3;
+	shader->studio_params_linked_count = GL_ActiveUniformExtent( shader, "u_StudioParams", GL_FLOAT_VEC4_ARB );
+	if( shader->studio_params_count != shader->studio_params_linked_count )
+	{
+		ALERT( at_error, "%s has inconsistent u_StudioParams metadata=%d linked=%d\n",
+			shader->name, shader->studio_params_count, shader->studio_params_linked_count );
+	}
 	if( GL_FindShaderDirective( shader, "STUDIO_SWAY_FOLIAGE" ) )
 		shader->u_FoliageSwayHeight = pglGetUniformLocationARB( shader->handle, "u_FoliageSwayHeight" );
 
@@ -2524,6 +2555,9 @@ word GL_UberShaderForSolidStudio( mstudiomaterial_t *mat, bool vertex_lighting,
 	memset( options, 0, sizeof( options ));
 
 	const bool bMasked = FBitSet( mat->flags, STUDIO_NF_MASKED ) ? true : false;
+	const bool has_chrome = FBitSet( mat->flags, STUDIO_NF_CHROME ) ? true : false;
+	const bool additive = FBitSet( mat->flags, STUDIO_NF_ADDITIVE ) ? true : false;
+	const int studio_params_count = additive ? ( has_chrome ? 2 : 1 ) : 3;
 
 	if( tr.materials[mat->gl_diffuse_id].fullbright ) // .monitor automatically sets this too
 		fullbright = true;
@@ -2555,7 +2589,7 @@ word GL_UberShaderForSolidStudio( mstudiomaterial_t *mat, bool vertex_lighting,
 	if( bone_weighting )
 		GL_AddShaderDirective( options, "STUDIO_BONEWEIGHTING" );
 
-	if( FBitSet( mat->flags, STUDIO_NF_CHROME ))
+	if( has_chrome )
 		GL_AddShaderDirective( options, "STUDIO_HAS_CHROME" );
 
 	if( vertex_lighting )
@@ -2566,7 +2600,7 @@ word GL_UberShaderForSolidStudio( mstudiomaterial_t *mat, bool vertex_lighting,
 		GL_AddShaderDirective( options, "STUDIO_FULLBRIGHT" );
 	}
 
-	if( FBitSet( mat->flags, STUDIO_NF_ADDITIVE ) )
+	if( additive )
 	{
 		GL_AddShaderDirective( options, "STUDIO_ADDITIVE" );
 	}
@@ -2631,6 +2665,15 @@ word GL_UberShaderForSolidStudio( mstudiomaterial_t *mat, bool vertex_lighting,
 		SetBits( mat->flags, STUDIO_NF_NODRAW );
 		return 0; // something bad happens
 	}
+	if( shader->studio_params_count != studio_params_count ||
+		shader->studio_params_linked_count != studio_params_count )
+	{
+		ALERT( at_error, "%s rejected: u_StudioParams variant=%d metadata=%d linked=%d\n",
+			shader->name, studio_params_count, shader->studio_params_count,
+			shader->studio_params_linked_count );
+		SetBits( mat->flags, STUDIO_NF_NODRAW );
+		return 0;
+	}
 
 	word shaderNum = (shader - glsl_programs);
 
