+void CStudioModelRenderer::InvalidateStudioMaterialCache( void )
+{
+	ResetRenderCache();
+#if defined( XASH_IOS )
+	if( !ios_material_cache_epoch_reported )
+	{
+		ALERT( at_console, "iOS studio texture cache epoch: cleanup=%u invalidated all studio material identities; next draw rebinds\n", material_cache_epoch );
+		ios_material_cache_epoch_reported = true;
+	}
+	if( !ios_material_terminal_reported )
+	{
+		ALERT( at_console, "iOS material-state terminal: first authoritative studio cleanup completed\n" );
+		ios_material_terminal_reported = true;
+	}
+#endif
 }
 
