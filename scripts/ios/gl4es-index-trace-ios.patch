diff --git a/src/gl/indextrace.c b/src/gl/indextrace.c
new file mode 100644
index 00000000..9aba847f
--- /dev/null
+++ b/src/gl/indextrace.c
@@ -0,0 +1,412 @@
+#include "indextrace.h"
+#include "state.h"
+#include "buffers.h"
+#include "gl4es.h"
+#include "glstate.h"
+#include "../glx/hardext.h"
+#include "../../include/gl4esinit.h"
+
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define IOS_INDEX_TRACE_WINDOW 64u
+#define IOS_INDEX_TRACE_RECORDS 5u
+#define IOS_INDEX_TRACE_GL_LINES 15u
+
+enum {
+    IOS_INDEX_FAMILY_WORLD = 1,
+    IOS_INDEX_FAMILY_STUDIO_EBO = 2,
+    IOS_INDEX_FAMILY_STUDIO_DECAL = 3
+};
+
+typedef struct {
+    unsigned long long id;
+    unsigned int family;
+    GLenum mode;
+    GLsizei count;
+    GLuint min_index;
+    GLuint max_index;
+    uint32_t checksum;
+    GLuint expected_min;
+    GLuint expected_max;
+    uint32_t expected_checksum;
+    GLuint start;
+    GLuint end;
+    GLint basevertex;
+    uintptr_t caller_pointer;
+    GLuint logical_ebo;
+    GLuint native_ebo;
+    GLsizeiptr ebo_size;
+    GLuint logical_vao;
+    GLuint position_buffer;
+    GLuint position_native_buffer;
+    GLsizeiptr position_size;
+    GLint position_size_components;
+    GLenum position_type;
+    GLsizei position_stride;
+    uintptr_t position_offset;
+    long long highest_legal_vertex;
+    int deferred;
+    int intercept;
+    int deferred_seen;
+    int native_seen;
+} ios_index_trace_record_t;
+
+static void (APIENTRY_GL4ES *ios_index_logger)(const char *);
+static int ios_index_logger_busy;
+static unsigned int ios_index_lines;
+static unsigned long long ios_index_next_id;
+static unsigned long long ios_index_frame;
+static char ios_index_map[64] = "<none>";
+static char ios_index_phase[32] = "startup";
+static unsigned int ios_index_ingress_count;
+static unsigned int ios_index_family_counts[4];
+static unsigned int ios_index_native_count;
+static unsigned int ios_index_deferred_count;
+static unsigned int ios_index_append_count;
+static unsigned int ios_index_seen_families;
+static int ios_index_seen_high;
+static int ios_index_seen_deferred;
+static int ios_index_first_divergence;
+static int ios_index_summary_emitted;
+static ios_index_trace_record_t ios_index_records[IOS_INDEX_TRACE_RECORDS];
+static unsigned int ios_index_record_count;
+static unsigned long long ios_index_active_id;
+static const void *ios_index_active_caller;
+
+static const char *ios_index_family_name(unsigned int family)
+{
+    switch(family) {
+        case IOS_INDEX_FAMILY_WORLD: return "world-client";
+        case IOS_INDEX_FAMILY_STUDIO_EBO: return "studio-ebo";
+        case IOS_INDEX_FAMILY_STUDIO_DECAL: return "studio-decal-client";
+        default: return "unknown";
+    }
+}
+
+static const char *ios_index_type_name(GLenum type)
+{
+    switch(type) {
+        case GL_UNSIGNED_BYTE: return "GL_UNSIGNED_BYTE";
+        case GL_UNSIGNED_SHORT: return "GL_UNSIGNED_SHORT";
+        case GL_UNSIGNED_INT: return "GL_UNSIGNED_INT";
+        default: return "other";
+    }
+}
+
+static unsigned int ios_index_type_bytes(GLenum type)
+{
+    switch(type) {
+        case GL_BYTE:
+        case GL_UNSIGNED_BYTE: return 1;
+        case GL_SHORT:
+        case GL_UNSIGNED_SHORT:
+        case GL_HALF_FLOAT: return 2;
+        case GL_INT:
+        case GL_UNSIGNED_INT:
+        case GL_FLOAT: return 4;
+        case GL_DOUBLE: return 8;
+        default: return 0;
+    }
+}
+
+static uint32_t ios_index_checksum(const GLuint *indices, GLsizei count)
+{
+    uint32_t hash = 2166136261u;
+    const unsigned char *bytes = (const unsigned char *)indices;
+    size_t size = (count > 0) ? (size_t)count * sizeof(GLuint) : 0;
+    for(size_t i = 0; i < size; ++i) {
+        hash ^= bytes[i];
+        hash *= 16777619u;
+    }
+    return hash;
+}
+
+static void ios_index_minmax(const GLuint *indices, GLsizei count, GLuint *minimum, GLuint *maximum)
+{
+    GLuint lo = 0, hi = 0;
+    if(indices && count > 0) {
+        lo = hi = indices[0];
+        for(GLsizei i = 1; i < count; ++i) {
+            if(indices[i] < lo) lo = indices[i];
+            if(indices[i] > hi) hi = indices[i];
+        }
+    }
+    *minimum = lo;
+    *maximum = hi;
+}
+
+static void ios_index_emit(int summary, const char *format, ...)
+{
+    char buffer[1024];
+    va_list args;
+    if(!ios_index_logger || ios_index_logger_busy)
+        return;
+    if((!summary && ios_index_lines >= IOS_INDEX_TRACE_GL_LINES - 1) ||
+       (summary && ios_index_lines >= IOS_INDEX_TRACE_GL_LINES))
+        return;
+    va_start(args, format);
+    vsnprintf(buffer, sizeof(buffer), format, args);
+    va_end(args);
+    buffer[sizeof(buffer) - 1] = '\0';
+    ios_index_logger_busy = 1;
+    ios_index_logger(buffer);
+    ios_index_logger_busy = 0;
+    ++ios_index_lines;
+}
+
+void set_index_trace_logger(void (APIENTRY_GL4ES *callback)(const char *))
+{
+    ios_index_logger = callback;
+    if(callback && ios_index_lines == 0) {
+        ios_index_emit(0, "iOS index trace logger: installed=1 sink=engine-console owner=libref_gl4es reentrant=guarded allocation=none");
+        ios_index_emit(0, "iOS index trace policy: window=%u records<=16 families=world-client,studio-ebo,studio-decal-client mutation=none error_queue=untouched",
+            IOS_INDEX_TRACE_WINDOW);
+    }
+}
+
+void set_index_trace_context(unsigned long long frame, const char *map, const char *phase)
+{
+    ios_index_frame = frame;
+    if(map) {
+        strncpy(ios_index_map, map, sizeof(ios_index_map) - 1);
+        ios_index_map[sizeof(ios_index_map) - 1] = '\0';
+    }
+    if(phase) {
+        strncpy(ios_index_phase, phase, sizeof(ios_index_phase) - 1);
+        ios_index_phase[sizeof(ios_index_phase) - 1] = '\0';
+    }
+}
+
+static unsigned int ios_index_family(void)
+{
+    vertexattrib_t *position = &glstate->vao->vertexattrib[ATT_VERTEX];
+    if(glstate->vao->elements)
+        return IOS_INDEX_FAMILY_STUDIO_EBO;
+    if(position->buffer)
+        return IOS_INDEX_FAMILY_WORLD;
+    return IOS_INDEX_FAMILY_STUDIO_DECAL;
+}
+
+static void ios_index_capture_vertex(ios_index_trace_record_t *record)
+{
+    vertexattrib_t *position = &glstate->vao->vertexattrib[ATT_VERTEX];
+    unsigned int scalar = ios_index_type_bytes(position->type);
+    GLsizei stride = position->stride ? position->stride : position->size * scalar;
+    record->logical_vao = glstate->vao->array;
+    record->position_size_components = position->size;
+    record->position_type = position->type;
+    record->position_stride = stride;
+    record->position_offset = (uintptr_t)position->pointer;
+    record->position_buffer = position->buffer ? position->buffer->buffer : 0;
+    record->position_native_buffer = position->buffer ? position->buffer->real_buffer : position->real_buffer;
+    record->position_size = position->buffer ? position->buffer->size : 0;
+    record->highest_legal_vertex = -1;
+    if(position->buffer && stride > 0 && scalar > 0) {
+        unsigned long long footprint = (unsigned long long)position->size * scalar;
+        unsigned long long offset = record->position_offset;
+        unsigned long long bytes = (unsigned long long)position->buffer->size;
+        if(offset + footprint <= bytes)
+            record->highest_legal_vertex = (long long)((bytes - offset - footprint) / (unsigned long long)stride);
+    }
+}
+
+static ios_index_trace_record_t *ios_index_find(unsigned long long id)
+{
+    for(unsigned int i = 0; i < ios_index_record_count; ++i)
+        if(ios_index_records[i].id == id)
+            return &ios_index_records[i];
+    return NULL;
+}
+
+unsigned long long ios_index_trace_ingress(const char *function, GLenum mode,
+    GLsizei count, GLenum type, const void *caller_indices, const GLuint *resolved,
+    GLuint start, GLuint end, GLint basevertex, int deferred, int intercept)
+{
+    unsigned long long id = ++ios_index_next_id;
+    unsigned int family;
+    GLuint minimum, maximum;
+    uint32_t checksum;
+    int first_family, first_high, first_deferred, sample;
+    ios_index_trace_record_t *record;
+    glbuffer_t *ebo;
+
+    if(type != GL_UNSIGNED_INT || !resolved || count <= 0)
+        return 0;
+    ++ios_index_ingress_count;
+    family = ios_index_family();
+    if(family <= IOS_INDEX_FAMILY_STUDIO_DECAL)
+        ++ios_index_family_counts[family];
+    ios_index_minmax(resolved, count, &minimum, &maximum);
+    checksum = ios_index_checksum(resolved, count);
+    first_family = !(ios_index_seen_families & (1u << family));
+    first_high = maximum > 65535u && !ios_index_seen_high;
+    first_deferred = deferred && !ios_index_seen_deferred;
+    sample = ios_index_ingress_count <= IOS_INDEX_TRACE_WINDOW &&
+        (first_family || first_high || first_deferred) &&
+        ios_index_record_count < IOS_INDEX_TRACE_RECORDS;
+    ios_index_seen_families |= 1u << family;
+    if(first_high) ios_index_seen_high = 1;
+    if(first_deferred) ios_index_seen_deferred = 1;
+    if(!sample) {
+        ios_index_trace_summary_if_ready();
+        return 0;
+    }
+
+    record = &ios_index_records[ios_index_record_count++];
+    memset(record, 0, sizeof(*record));
+    record->id = id;
+    record->family = family;
+    record->mode = mode;
+    record->count = count;
+    record->min_index = minimum;
+    record->max_index = maximum;
+    record->checksum = checksum;
+    record->expected_min = minimum + basevertex;
+    record->expected_max = maximum + basevertex;
+    record->expected_checksum = checksum;
+    record->start = start;
+    record->end = end;
+    record->basevertex = basevertex;
+    record->caller_pointer = (uintptr_t)caller_indices;
+    record->deferred = deferred;
+    record->intercept = intercept;
+    ebo = glstate->vao->elements;
+    if(ebo) {
+        record->logical_ebo = ebo->buffer;
+        record->native_ebo = ebo->real_buffer;
+        record->ebo_size = ebo->size;
+    }
+    ios_index_capture_vertex(record);
+    ios_index_emit(0,
+        "iOS index trace ingress: id=%llu frame=%llu map=%s phase=%s family=%s route=%s function=%s mode=0x%04x count=%d type=%s start=%u end=%u source=%s logical_vao=%u ebo=%u native_ebo=%u ebo_size=%lld offset_or_pointer=0x%llx min=%u max=%u checksum=%08x base=%d pos_enabled=%d pos_type=0x%04x pos_components=%d pos_stride=%d pos_offset=%llu pos_buffer=%u pos_native=%u pos_bytes=%lld highest_legal=%lld",
+        record->id, ios_index_frame, ios_index_map, ios_index_phase,
+        ios_index_family_name(family), deferred ? (intercept ? "intercept" : "deferred") : "direct",
+        function, mode, count, ios_index_type_name(type), start, end,
+        ebo ? "ebo-offset" : "client", record->logical_vao, record->logical_ebo,
+        record->native_ebo, (long long)record->ebo_size,
+        (unsigned long long)record->caller_pointer, minimum, maximum, checksum,
+        basevertex, glstate->vao->vertexattrib[ATT_VERTEX].enabled,
+        record->position_type, record->position_size_components, record->position_stride,
+        (unsigned long long)record->position_offset, record->position_buffer,
+        record->position_native_buffer, (long long)record->position_size,
+        record->highest_legal_vertex);
+    return id;
+}
+
+void ios_index_trace_deferred(unsigned long long id, const GLuint *indices,
+    GLsizei count, GLuint vertex_first, GLuint vertex_count, int appended)
+{
+    ios_index_trace_record_t *record = ios_index_find(id);
+    GLuint minimum, maximum;
+    uint32_t checksum;
+    if(!record || !indices || count <= 0)
+        return;
+    ios_index_minmax(indices, count, &minimum, &maximum);
+    checksum = ios_index_checksum(indices, count);
+    record->expected_min = minimum;
+    record->expected_max = maximum;
+    record->expected_checksum = checksum;
+    ++ios_index_deferred_count;
+    if(appended)
+        ++ios_index_append_count;
+    if(!record->deferred_seen) {
+        record->deferred_seen = 1;
+        ios_index_emit(0,
+            "iOS index trace deferred: id=%llu family=%s route=%s width=32 count=%d normalized_min=%u normalized_max=%u checksum=%08x copied_vertex_first=%u copied_vertex_count=%u ownership=renderlist append_merge=%d append_tracking=enabled lifetime=replay",
+            id, ios_index_family_name(record->family), record->intercept ? "intercept" : "deferred",
+            count, minimum, maximum, checksum, vertex_first, vertex_count, appended);
+    }
+}
+
+void ios_index_trace_set_active(unsigned long long id, const void *caller_indices)
+{
+    ios_index_active_id = id;
+    ios_index_active_caller = caller_indices;
+}
+
+void ios_index_trace_native(unsigned long long id, const char *function,
+    GLenum mode, GLsizei count, GLenum type, const void *indices,
+    GLuint native_ebo, const GLuint *owned_indices, GLuint segment_offset,
+    GLuint segment_count)
+{
+    ios_index_trace_record_t *record;
+    const GLuint *segment;
+    GLuint minimum = 0, maximum = 0;
+    uint32_t checksum = 0;
+    int mismatch = 0;
+    const char *reason = "none";
+    if(!id)
+        id = ios_index_active_id;
+    record = ios_index_find(id);
+    if(!record)
+        return;
+    if(record->native_seen)
+        return;
+    segment = owned_indices ? owned_indices + segment_offset : NULL;
+    if(!segment && native_ebo && glstate->vao->elements &&
+       (uintptr_t)indices <= (uintptr_t)glstate->vao->elements->size &&
+       (unsigned long long)(uintptr_t)indices +
+           (unsigned long long)record->count * sizeof(GLuint) <=
+           (unsigned long long)glstate->vao->elements->size) {
+        segment = (const GLuint *)((const unsigned char *)glstate->vao->elements->data +
+            (uintptr_t)indices);
+        segment_count = record->count;
+        segment_offset = 0;
+    }
+    if(segment && segment_count > 0) {
+        ios_index_minmax(segment, (GLsizei)segment_count, &minimum, &maximum);
+        checksum = ios_index_checksum(segment, (GLsizei)segment_count);
+    }
+    ++ios_index_native_count;
+    record->native_seen = 1;
+    if(type != GL_UNSIGNED_INT) { mismatch = 1; reason = "width"; }
+    else if(segment_count && segment_count != (GLuint)record->count) { mismatch = 1; reason = "count"; }
+    else if(segment && (minimum != record->expected_min || maximum != record->expected_max)) { mismatch = 1; reason = "minmax"; }
+    else if(segment && checksum != record->expected_checksum) { mismatch = 1; reason = "checksum"; }
+    else if(!record->deferred && record->logical_ebo &&
+        (!native_ebo || (uintptr_t)indices != record->caller_pointer)) { mismatch = 1; reason = "ebo-offset-pair"; }
+    else if(!record->deferred && !record->logical_ebo && native_ebo) { mismatch = 1; reason = "client-with-native-ebo"; }
+
+    ios_index_emit(0,
+        "iOS index trace native: id=%llu family=%s function=%s mode=0x%04x type=%s count=%d source=%s pointer_or_offset=0x%llx native_ebo=%u segment_offset=%u segment_count=%u min=%u max=%u checksum=%08x logical_vao=%u pos_buffer=%u pos_native=%u pos_stride=%d pos_offset=%llu expected_count=%d expected_min=%u expected_max=%u expected_checksum=%08x match=%d",
+        id, ios_index_family_name(record->family), function, mode, ios_index_type_name(type), count,
+        native_ebo ? "ebo-offset" : "client", (unsigned long long)(uintptr_t)indices,
+        native_ebo, segment_offset, segment_count, minimum, maximum, checksum,
+        glstate->vao->array, record->position_buffer, record->position_native_buffer,
+        record->position_stride, (unsigned long long)record->position_offset,
+        record->count, record->expected_min, record->expected_max,
+        record->expected_checksum, !mismatch);
+    if(mismatch && !ios_index_first_divergence) {
+        ios_index_first_divergence = 1;
+        ios_index_emit(0,
+            "iOS index trace first divergence: id=%llu family=%s field=%s ingress_type=GL_UNSIGNED_INT native_type=%s ingress_count=%d native_count=%d ingress_pointer=0x%llx native_pointer=0x%llx ingress_ebo=%u native_ebo=%u",
+            id, ios_index_family_name(record->family), reason, ios_index_type_name(type),
+            record->count, count, (unsigned long long)record->caller_pointer,
+            (unsigned long long)(uintptr_t)indices, record->logical_ebo, native_ebo);
+    }
+    if(id == ios_index_active_id) {
+        ios_index_active_id = 0;
+        ios_index_active_caller = NULL;
+    }
+    ios_index_trace_summary_if_ready();
+}
+
+void ios_index_trace_summary_if_ready(void)
+{
+    if(ios_index_summary_emitted || ios_index_ingress_count < IOS_INDEX_TRACE_WINDOW)
+        return;
+    ios_index_summary_emitted = 1;
+    ios_index_emit(1,
+        "iOS index trace summary: window=%u ingress=%u native=%u deferred=%u append_merge=%u world=%u studio_ebo=%u studio_decal=%u high=%d first_divergence=%d covered_mask=0x%02x uncovered=%s records=%u cap=16",
+        IOS_INDEX_TRACE_WINDOW, ios_index_ingress_count, ios_index_native_count,
+        ios_index_deferred_count, ios_index_append_count,
+        ios_index_family_counts[IOS_INDEX_FAMILY_WORLD],
+        ios_index_family_counts[IOS_INDEX_FAMILY_STUDIO_EBO],
+        ios_index_family_counts[IOS_INDEX_FAMILY_STUDIO_DECAL], ios_index_seen_high,
+        ios_index_first_divergence, ios_index_seen_families,
+        (ios_index_seen_families & 0x0eu) == 0x0eu ? "none" : "one-or-more-families",
+        ios_index_lines + 1);
+}
