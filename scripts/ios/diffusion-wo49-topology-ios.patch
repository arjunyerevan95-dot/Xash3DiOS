+#if defined( XASH_IOS )
+unsigned long long CStudioModelRenderer::WO49ProduceTopology( const vbomesh_t *mesh )
+{
+	if( !m_pModelInstance || !m_pModelInstance->m_VlCache ||
+		!FBitSet( m_pModelInstance->info_flags, MF_VERTEX_LIGHTING ) ||
+		FBitSet( RI->params, RP_SHADOWPASS ) || mesh->wo49_aggregateVerts <= 65535u ||
+		mesh->numVerts <= 0 || mesh->numElems <= 0 )
+		return 0;
+
+	WO49ResolveTopologyAPI();
+	if( !pWO49TopologyProducer )
+		return 0;
+
+	wo49_topology_producer_desc_t desc;
+	memset( &desc, 0, sizeof( desc ) );
+	desc.version = WO49_TOPOLOGY_VERSION;
+	desc.size = sizeof( desc );
+	desc.frame = tr.realframecount;
+	desc.producer = "CStudioModelRenderer::AddMeshToDrawList";
+	desc.model = m_pRenderModel ? m_pRenderModel->name : "<none>";
+	desc.cacheIdentity = (unsigned long long)(size_t)m_pModelInstance->m_VlCache;
+	desc.instanceIdentity = (unsigned long long)(size_t)m_pModelInstance;
+	desc.meshIdentity = (unsigned long long)(size_t)mesh;
+	desc.aggregateVerts = mesh->wo49_aggregateVerts;
+	desc.numVerts = mesh->numVerts;
+	desc.numElems = mesh->numElems;
+	desc.mode = GL_TRIANGLES;
+	desc.indexType = GL_UNSIGNED_INT;
+	desc.indexSource = 1; // immutable per-mesh EBO upload
+	desc.indexMin = mesh->wo49_indexMin;
+	desc.indexMax = mesh->wo49_indexMax;
+	desc.indexChecksum = mesh->wo49_indexChecksum;
+	desc.baseVertex = 0;
+	desc.rangeStart = 0;
+	desc.rangeEnd = mesh->numVerts - 1;
+	desc.layout = mesh->wo49_layout;
+	desc.stride = mesh->wo49_stride;
+	desc.vao = mesh->vao;
+	desc.vbo = mesh->vbo;
+	desc.ebo = mesh->ibo;
+	desc.vboBytes = mesh->cacheSize;
+	desc.eboBytes = (unsigned long long)mesh->numElems * sizeof( unsigned int );
+	desc.vertexUploadOffset = 0;
+	desc.indexUploadOffset = 0;
+	desc.vertexChecksum = mesh->wo49_vertexChecksum;
+	desc.positionChecksum = mesh->wo49_positionChecksum;
+	desc.highestLocalVertex = mesh->numVerts - 1;
+	desc.highestPackedVertexByte = mesh->cacheSize ? mesh->cacheSize - 1 : 0;
+	WO49DescribeLayout( &desc );
+	return pWO49TopologyProducer( &desc );
+}
+#endif
