+
+static unsigned int WO49Checksum( const void *data, size_t bytes )
+{
+	const byte *cursor = (const byte *)data;
+	unsigned int hash = 2166136261u;
+	for( size_t i = 0; i < bytes; ++i )
+	{
+		hash ^= cursor[i];
+		hash *= 16777619u;
+	}
+	return hash;
+}
+
+static unsigned int WO49PositionChecksum( const void *data, size_t stride, unsigned int count )
+{
+	const byte *cursor = (const byte *)data;
+	unsigned int hash = 2166136261u;
+	for( unsigned int vertex = 0; vertex < count; ++vertex )
+	{
+		for( size_t i = 0; i < sizeof( float ) * 3; ++i )
+		{
+			hash ^= cursor[vertex * stride + i];
+			hash *= 16777619u;
+		}
+	}
+	return hash;
+}
+
+static void WO49ResolveTopologyAPI( void )
+{
+	if( wo49_topology_resolved )
+		return;
+	wo49_topology_resolved = true;
+	pWO49TopologyProducer = (wo49_topology_producer_fn)GL_GetProcAddress( "gl4es_iOSWO49TopologyProducer" );
+	pWO49TopologyArm = (wo49_topology_token_fn)GL_GetProcAddress( "gl4es_iOSWO49TopologyArm" );
+	pWO49TopologyFinish = (wo49_topology_token_fn)GL_GetProcAddress( "gl4es_iOSWO49TopologyFinish" );
+	pWO49TopologyAbsence = (wo49_topology_absence_fn)GL_GetProcAddress( "gl4es_iOSWO49TopologyAbsence" );
+}
+
+static void WO49AddAttribute( wo49_topology_producer_desc_t *desc, unsigned int index,
+	unsigned int size, unsigned int type, unsigned int stride, unsigned long long offset )
+{
+	if( desc->attrCount >= WO49_TOPOLOGY_ATTR_CAP )
+		return;
+	wo49_topology_attr_desc_t *attr = &desc->attrs[desc->attrCount++];
+	attr->index = index;
+	attr->enabled = 1;
+	attr->size = size;
+	attr->type = type;
+	attr->normalized = GL_FALSE;
+	attr->integer = 0;
+	attr->stride = stride;
+	attr->offset = offset;
+}
+
+static void WO49DescribeLayout( wo49_topology_producer_desc_t *desc )
+{
+	WO49AddAttribute( desc, ATTR_INDEX_POSITION, 3, GL_FLOAT, desc->stride, 0 );
+	WO49AddAttribute( desc, ATTR_INDEX_TANGENT, 3, GL_FLOAT, desc->stride, sizeof( Vector ) * 2 );
+	WO49AddAttribute( desc, ATTR_INDEX_BINORMAL, 3, GL_FLOAT, desc->stride, sizeof( Vector ) * 3 );
+	WO49AddAttribute( desc, ATTR_INDEX_NORMAL, 3, GL_FLOAT, desc->stride, sizeof( Vector ) );
+	WO49AddAttribute( desc, ATTR_INDEX_TEXCOORD0, 2, GL_FLOAT, desc->stride, sizeof( Vector ) * 4 );
+	if( desc->layout == 0 || desc->layout == 2 || desc->layout == 3 )
+		WO49AddAttribute( desc, ATTR_INDEX_BONE_INDEXES, 4, GL_BYTE, desc->stride, sizeof( Vector ) * 4 + sizeof( float ) * 2 );
+	if( desc->layout == 2 || desc->layout == 3 )
+		WO49AddAttribute( desc, ATTR_INDEX_BONE_WEIGHTS, 4, GL_UNSIGNED_BYTE, desc->stride, sizeof( Vector ) * 4 + sizeof( float ) * 2 + 4 );
+	if( desc->layout == 1 )
+	{
+		WO49AddAttribute( desc, ATTR_INDEX_LIGHT_COLOR, 4, GL_FLOAT, desc->stride, sizeof( Vector ) * 4 + sizeof( float ) * 2 );
+		WO49AddAttribute( desc, ATTR_INDEX_LIGHT_VECS, 4, GL_FLOAT, desc->stride, sizeof( Vector ) * 4 + sizeof( float ) * 6 );
+	}
+	else if( desc->layout == 3 )
+	{
+		WO49AddAttribute( desc, ATTR_INDEX_LIGHT_COLOR, 4, GL_FLOAT, desc->stride, sizeof( Vector ) * 4 + sizeof( float ) * 2 + 8 );
+		WO49AddAttribute( desc, ATTR_INDEX_LIGHT_VECS, 4, GL_FLOAT, desc->stride, sizeof( Vector ) * 4 + sizeof( float ) * 6 + 8 );
+	}
+}
