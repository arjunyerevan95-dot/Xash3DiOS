+			if( numSamples >= IOS_GRASS_SAMPLE_STRIDE )
+				IOS_GRASS_TRACE( "iOS foliage: t=%.3f build=%d surface=%d stage=triangle-begin entry=%d triangle=%d samples=%d accepted=%d\n",
+					Sys_DoubleTime(), ios_build, ios_surface, i, j, numSamples, total );
+#endif
+
 			for( int k = 0; k < numSamples; k++ )
 			{
+#if XASH_IOS
+				if( k > 0 && !( k % IOS_GRASS_SAMPLE_STRIDE ))
+					IOS_GRASS_TRACE( "iOS foliage: t=%.3f build=%d surface=%d stage=sample-progress entry=%d triangle=%d sample=%d/%d accepted=%d\n",
+						Sys_DoubleTime(), ios_build, ios_surface, i, j, k, numSamples, total );
+#endif
 				// Create a random sample...
