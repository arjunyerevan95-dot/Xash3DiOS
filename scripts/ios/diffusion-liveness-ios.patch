+			IOS_GRASS_TRACE_LIMIT, IOS_GRASS_SAMPLE_STRIDE );
+	IOS_GRASS_TRACE( "iOS foliage: t=%.3f build=%d surface=%d stage=construct-begin expected=%d verts=%d entries=%d\n",
