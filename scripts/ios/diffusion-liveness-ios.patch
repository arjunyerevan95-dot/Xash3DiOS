@@ -1079,6 +1104,10 @@ void R_ConstructGrass( msurface_t *psurf )
 				g->cva.mesh = (grassvert_t *)ptr;
 				ptr += mesh_size;
 			}
+
+			IOS_GRASS_TRACE( "iOS foliage: t=%.3f build=%d surface=%d stage=allocation-return bytes=%u expected=%d\n",
+				Sys_DoubleTime(), ios_build, ios_surface,
