+unsigned long long CStudioModelRenderer::WO52BeginMaterialTrace(
+	const gl_studiomesh_t *entry, const mstudiomaterial_t *mat,
+	int materialSlot, int diffuseObject, int textureMode, int textureObject, int normalUnit,
+	int auxMode, int auxTexture, int cubemapTexture, bool lightpass,
+	const Vector meshparams[3] )
+{
+	WO49ResolveTopologyAPI();
+	if( !pWO52MaterialBegin || !entry || !entry->mesh || !mat ||
+		!RI->currentshader || textureObject <= 0 )
+		return 0;
+
+	wo52_material_producer_desc_t desc;
+	memset( &desc, 0, sizeof( desc ) );
+	desc.version = WO52_MATERIAL_VERSION;
+	desc.size = sizeof( desc );
+	desc.frame = tr.realframecount;
+	desc.generation = wo52_material_generation;
+	desc.entity = m_pCurrentEntity ? m_pCurrentEntity->index : 0;
+	desc.modelHandle = m_pCurrentEntity ? m_pCurrentEntity->modelhandle : 0;
+	desc.skin = m_pCurrentEntity ? m_pCurrentEntity->curstate.skin : 0;
+	desc.bodypart = entry->wo52_bodypart;
+	desc.mesh = entry->wo52_mesh;
+	desc.material = materialSlot;
+	desc.diffuseObject = diffuseObject;
+	desc.fallbackObject = tr.materials[diffuseObject].gl_fallbacktex_id;
+	desc.animationId = tr.materials[diffuseObject].animation_id;
+	desc.monitorObject = m_pCurrentEntity &&
+		m_pCurrentEntity->index < 8192 ?
+		tr.studio_screen_tex[m_pCurrentEntity->index] : 0;
+	desc.droneObject = tr.DroneViewTex;
+	desc.normalObject = tr.materials[diffuseObject].gl_normalmap_id;
+	desc.cubemapObject = cubemapTexture;
+	desc.interiorObject = tr.materials[diffuseObject].gl_interiormap_id;
+	desc.blendObject = tr.materials[diffuseObject].gl_blendtex_id;
+	desc.maskObject = tr.materials[diffuseObject].gl_colormask_id;
+	desc.meshIdentity = (unsigned long long)(size_t)entry->mesh;
+	desc.cacheEpoch = material_cache_epoch;
+	desc.lightpass = lightpass ? 1 : 0;
+	desc.map = worldmodel ? worldmodel->name : "<none>";
+	desc.model = entry->model ? entry->model->name : "<none>";
+	desc.materialName = tr.materials[diffuseObject].name;
+	desc.sourceName = mat->pSource ? mat->pSource->name : "<none>";
+	desc.materialFlags = mat->flags;
+	desc.shaderIndex = entry->hProgram;
+	desc.logicalProgram = RI->currentshader->handle;
+	desc.optionsHash = WO49Checksum( RI->currentshader->options,
+		Q_strlen( RI->currentshader->options ) );
+	desc.shaderStatus = RI->currentshader->status;
+	desc.colorMapLocation = RI->currentshader->u_ColorMap;
+	desc.renderColorLocation = RI->currentshader->u_RenderColor;
+	desc.meshParamsLocation = RI->currentshader->u_MeshParams;
+	desc.studioLightingLocation = RI->currentshader->u_StudioLighting;
+	const float entity_r = m_pCurrentEntity->curstate.rendercolor.r / 255.0f;
+	const float entity_g = m_pCurrentEntity->curstate.rendercolor.g / 255.0f;
+	const float entity_b = m_pCurrentEntity->curstate.rendercolor.b / 255.0f;
+	if( !r_lightmap->value && ( tr.materials[diffuseObject].ApplyColor ||
+		tr.materials[diffuseObject].gl_colormask_id > 0 ) )
+	{
+		desc.renderColor[0] = entity_r;
+		desc.renderColor[1] = entity_g;
+		desc.renderColor[2] = entity_b;
+		desc.renderColor[3] = tr.blend;
+		if( m_pCurrentEntity->curstate.rendermode == kRenderTransAdd &&
+			!m_pCurrentEntity->curstate.rendercolor.r &&
+			!m_pCurrentEntity->curstate.rendercolor.g &&
+			!m_pCurrentEntity->curstate.rendercolor.b )
+			desc.renderColor[0] = desc.renderColor[1] = desc.renderColor[2] = 1.0f;
+	}
+	else
+	{
+		switch( m_pCurrentEntity->curstate.rendermode )
+		{
+		case kRenderTransColor:
+			desc.renderColor[0] = entity_r;
+			desc.renderColor[1] = entity_g;
+			desc.renderColor[2] = entity_b;
+			desc.renderColor[3] = tr.blend;
+			break;
+		case kRenderTransAdd:
+			desc.renderColor[0] = desc.renderColor[1] =
+				desc.renderColor[2] = tr.blend;
+			desc.renderColor[3] = 1.0f;
+			break;
+		case kRenderNormal:
+		case kRenderTransAlpha:
+			desc.renderColor[0] = desc.renderColor[1] =
+				desc.renderColor[2] = desc.renderColor[3] = 1.0f;
+			break;
+		default:
+			desc.renderColor[0] = desc.renderColor[1] =
+				desc.renderColor[2] = 1.0f;
+			desc.renderColor[3] = tr.blend;
+			break;
+		}
+	}
+	desc.meshParams[0] = meshparams[2].x;
+	desc.meshParams[1] = meshparams[2].y;
+	desc.meshParams[2] = meshparams[2].z;
+	desc.meshParams[3] = tr.time;
+	desc.fullbright = FBitSet( mat->flags, STUDIO_NF_FULLBRIGHT ) ||
+		m_pCurrentEntity->curstate.renderfx == kRenderFxFullbright ||
+		m_pCurrentEntity->curstate.renderfx == kRenderFxFullbrightNoShadows;
+	desc.additive = FBitSet( mat->flags, STUDIO_NF_ADDITIVE ) ||
+		m_pCurrentEntity->curstate.rendermode == kRenderTransAdd;
+	desc.vertexLighting = FBitSet( m_pModelInstance->info_flags, MF_VERTEX_LIGHTING );
+
+	WO52AddMaterialUnit( &desc, 0, textureObject, textureMode,
+		RI->currentshader->u_ColorMap );
+	if( RI->currentshader->status & SHADER_USE_BUMP )
+		WO52AddMaterialUnit( &desc, normalUnit,
+		tr.materials[diffuseObject].gl_normalmap_id,
+			STUDIO_TEXTURE_MODE_BASE, RI->currentshader->u_NormalMap );
+	if( auxMode != STUDIO_TEXTURE_MODE_INVALID )
+		WO52AddMaterialUnit( &desc, 4, auxTexture, auxMode,
+			auxMode == STUDIO_TEXTURE_MODE_INTERIOR ?
+			RI->currentshader->u_InteriorMap : RI->currentshader->u_BlendTexture );
+	if( !lightpass && ( RI->currentshader->status & SHADER_USE_CUBEMAPS ) )
+		WO52AddMaterialUnit( &desc, 2, cubemapTexture,
+			STUDIO_TEXTURE_MODE_BASE, RI->currentshader->u_CubemapBox );
+	if( tr.materials[diffuseObject].gl_colormask_id > 0 )
+		WO52AddMaterialUnit( &desc, 5,
+			tr.materials[diffuseObject].gl_colormask_id,
+			STUDIO_TEXTURE_MODE_BASE, RI->currentshader->u_ColorMask );
+	return pWO52MaterialBegin( &desc );
+}
