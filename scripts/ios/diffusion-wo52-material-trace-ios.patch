+void CStudioModelRenderer::WO52RecordMaterialCache( unsigned long long token,
+	bool lightpass, const int requestedObject[6], const int beforeObject[6],
+	const int beforeMode[6], const int issued[6] )
+{
+	(void)lightpass;
+	if( !token || !pWO52MaterialCache )
+		return;
+	wo52_material_cache_desc_t desc;
+	memset( &desc, 0, sizeof( desc ) );
+	desc.version = WO52_MATERIAL_VERSION;
+	desc.size = sizeof( desc );
+	desc.token = token;
+	desc.cacheEpoch = material_cache_epoch;
+	for( int unit = 0; unit < 6; ++unit )
+	{
+		if( requestedObject[unit] <= 0 )
+			continue;
+		wo52_material_cache_unit_t *entry = &desc.units[desc.unitCount++];
+		entry->unit = unit;
+		entry->requestedObject = requestedObject[unit];
+		entry->beforeObject = beforeObject[unit];
+		entry->beforeMode = beforeMode[unit];
+		entry->issued = issued[unit];
+		switch( unit )
+		{
+		case 0:
+			entry->afterObject = cached_texture_object;
+			entry->afterMode = cached_texture_mode;
+			break;
+		case 1:
+		case 3:
+			entry->afterObject = cached_normalmap;
+			entry->afterMode = STUDIO_TEXTURE_MODE_BASE;
+			break;
+		case 2:
+			entry->afterObject = cached_cubemap_texture;
+			entry->afterMode = STUDIO_TEXTURE_MODE_BASE;
+			break;
+		case 4:
+			entry->afterObject = cached_aux_texture;
+			entry->afterMode = cached_aux_mode;
+			break;
+		case 5:
+			entry->afterObject = cached_colormask;
+			entry->afterMode = STUDIO_TEXTURE_MODE_BASE;
+			break;
+		}
+	}
+	pWO52MaterialCache( &desc );
+}
 #endif
 
