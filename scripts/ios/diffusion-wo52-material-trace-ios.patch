+static void WO52Transition( const char *event )
+{
+	const unsigned int event_hash = WO49Checksum( event ? event : "unknown",
+		Q_strlen( event ? event : "unknown" ) );
+	for( unsigned int i = 0; i < wo52_transition_count; ++i )
+	{
+		if( wo52_transition_hashes[i] == event_hash &&
+			wo52_transition_generations[i] == wo52_material_generation )
+			return;
+	}
+	WO49ResolveTopologyAPI();
+	if( pWO52MaterialTransition && wo52_transition_count < 128 )
+	{
+		wo52_transition_hashes[wo52_transition_count] = event_hash;
+		wo52_transition_generations[wo52_transition_count] = wo52_material_generation;
+		++wo52_transition_count;
+		pWO52MaterialTransition( event, wo52_material_generation,
+			tr.realframecount, worldmodel ? worldmodel->name : "<none>" );
+	}
+	else if( pWO52MaterialTransition && !wo52_transition_overflow )
+	{
+		wo52_transition_overflow = true;
+		pWO52MaterialTransition( "transition-overflow-cap-128",
+			wo52_material_generation, tr.realframecount,
+			worldmodel ? worldmodel->name : "<none>" );
+	}
+}
+
+void R_IOSWO52MaterialTransition( const char *event )
+{
+	if( event && !Q_strcmp( event, "R_NewMap" ) )
+		++wo52_material_generation;
+	WO52Transition( event );
+}
