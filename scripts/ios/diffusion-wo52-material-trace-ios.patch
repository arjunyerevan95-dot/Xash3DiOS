+static void WO52AddMaterialUnit( wo52_material_producer_desc_t *desc,
+	unsigned int unit, int object, int mode, int samplerLocation )
+{
+	if( object <= 0 || desc->unitCount >= WO52_MATERIAL_UNIT_CAP )
+		return;
+	wo52_material_unit_desc_t *entry = &desc->units[desc->unitCount++];
+	memset( entry, 0, sizeof( *entry ) );
+	entry->unit = unit;
+	entry->engineObject = object;
+	entry->logicalObject = RENDER_GET_PARM( PARM_TEX_TEXNUM, object );
+	entry->target = RENDER_GET_PARM( PARM_TEX_TARGET, object );
+	entry->width = RENDER_GET_PARM( PARM_TEX_WIDTH, object );
+	entry->height = RENDER_GET_PARM( PARM_TEX_HEIGHT, object );
+	entry->format = RENDER_GET_PARM( PARM_TEX_GLFORMAT, object );
+	entry->resourceFlags = RENDER_GET_PARM( PARM_TEX_FLAGS, object );
+	entry->mode = mode;
+	entry->ready = entry->logicalObject != 0 && entry->width != 0 && entry->height != 0;
+	entry->samplerLocation = samplerLocation;
+	entry->samplerValue = unit;
+}
