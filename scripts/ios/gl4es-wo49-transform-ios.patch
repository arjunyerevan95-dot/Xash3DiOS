+    ios_wo49_emit("WO49 transform policy: tokens=1 programs=1 draws=1 frames=1 selection=first-rigid-vertexlit-truck_new-ch1map0 storage=fixed required=MVP+modelview+boneQuaternion0+bonePosition0 sway=conditional terminal=all-required-fields mutation=none error_queue=untouched");
+    ios_wo49_emit(
