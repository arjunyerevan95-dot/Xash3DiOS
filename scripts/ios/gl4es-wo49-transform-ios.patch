+static int ios_wo49_transform_target(const char *name)
+{
+    if(!name) return -1;
+    if(!strncmp(name, "_gl4es_ModelViewProjectionMatrix",
+        strlen("_gl4es_ModelViewProjectionMatrix")) ||
+       !strncmp(name, "gl_ModelViewProjectionMatrix",
+        strlen("gl_ModelViewProjectionMatrix")))
+        return IOS_WO49_TRANSFORM_MVP;
+    if(!strncmp(name, "_gl4es_ModelViewMatrix",
+        strlen("_gl4es_ModelViewMatrix")) ||
+       !strncmp(name, "gl_ModelViewMatrix",
+        strlen("gl_ModelViewMatrix")))
+        return IOS_WO49_TRANSFORM_MODELVIEW;
+    if(!strncmp(name, "u_BoneQuaternion", strlen("u_BoneQuaternion")))
+        return IOS_WO49_TRANSFORM_BONE_QUATERNION;
+    if(!strncmp(name, "u_BonePosition", strlen("u_BonePosition")))
+        return IOS_WO49_TRANSFORM_BONE_POSITION;
+    if(!strncmp(name, "u_FoliageSwayHeight", strlen("u_FoliageSwayHeight")))
+        return IOS_WO49_TRANSFORM_SWAY_HEIGHT;
+    return -1;
+}
+
+static GLenum ios_wo49_transform_expected_type(int target)
+{
+    switch(target) {
+        case IOS_WO49_TRANSFORM_MVP:
+        case IOS_WO49_TRANSFORM_MODELVIEW: return GL_FLOAT_MAT4;
+        case IOS_WO49_TRANSFORM_BONE_QUATERNION: return GL_FLOAT_VEC4;
+        case IOS_WO49_TRANSFORM_BONE_POSITION: return GL_FLOAT_VEC3;
+        case IOS_WO49_TRANSFORM_SWAY_HEIGHT: return GL_FLOAT;
+        default: return 0;
+    }
+}
+
+static int ios_wo49_transform_expected_width(int target)
+{
+    switch(target) {
+        case IOS_WO49_TRANSFORM_MVP:
+        case IOS_WO49_TRANSFORM_MODELVIEW: return 16;
+        case IOS_WO49_TRANSFORM_BONE_QUATERNION: return 4;
+        case IOS_WO49_TRANSFORM_BONE_POSITION: return 3;
+        case IOS_WO49_TRANSFORM_SWAY_HEIGHT: return 1;
+        default: return 0;
+    }
+}
+
+static int ios_wo49_transform_expected_count(int target)
+{
+    switch(target) {
+        case IOS_WO49_TRANSFORM_BONE_QUATERNION:
+            return (int)ios_wo49_transform.producer.boneQuaternionCount;
+        case IOS_WO49_TRANSFORM_BONE_POSITION:
+            return (int)ios_wo49_transform.producer.bonePositionCount;
+        default: return 1;
+    }
+}
+
+static uniform_t *ios_wo49_transform_find_uniform(program_t *program,
+    GLint location)
+{
+    khint_t k;
+    if(!program || !program->uniform || location < 0)
+        return NULL;
+    k = kh_get(uniformlist, program->uniform, location);
+    return k == kh_end(program->uniform) ? NULL : kh_value(program->uniform, k);
+}
+
+static const void *ios_wo49_transform_expected_value(int target)
+{
+    switch(target) {
+        case IOS_WO49_TRANSFORM_MVP: return ios_wo49_transform.producer.mvp;
+        case IOS_WO49_TRANSFORM_MODELVIEW: return ios_wo49_transform.producer.modelview;
+        case IOS_WO49_TRANSFORM_BONE_QUATERNION: return ios_wo49_transform.producer.boneQuaternion;
+        case IOS_WO49_TRANSFORM_BONE_POSITION: return ios_wo49_transform.producer.bonePosition;
+        case IOS_WO49_TRANSFORM_SWAY_HEIGHT: return &ios_wo49_transform.producer.swayHeight;
+        default: return NULL;
+    }
+}
+
+static int ios_wo49_transform_first_component(const void *expected,
+    const void *actual, unsigned int bytes)
+{
+    const unsigned char *a = (const unsigned char *)expected;
+    const unsigned char *b = (const unsigned char *)actual;
+    if(!a || !b) return -1;
+    for(unsigned int i = 0; i + sizeof(GLfloat) <= bytes; i += sizeof(GLfloat))
+        if(memcmp(a + i, b + i, sizeof(GLfloat)))
+            return (int)(i / sizeof(GLfloat));
+    return -1;
+}
+
+static void ios_wo49_transform_reflect(program_t *program, GLint location,
+    uniform_t *uniform)
+{
+    int target;
+    ios_wo49_transform_uniform_t *record;
+    if(!uniform || (target = ios_wo49_transform_target(uniform->name)) < 0)
+        return;
+    record = &ios_wo49_transform.uniform[target];
+    if(!record->required)
+        return;
+    record->reflected = 1;
+    record->gl4es_location = location;
+    record->native_location = uniform->id;
+    record->reflected_type = uniform->type;
+    record->reflected_extent = uniform->size;
+    record->native_program = program ? program->id : 0;
+}
+
+static void ios_wo49_transform_copy_value(unsigned char *destination,
+    const void *value, unsigned int bytes)
+{
+    if(!destination || !value || !bytes || bytes > 64u)
+        return;
+    memcpy(destination, value, bytes);
+}
+
+static void ios_wo49_transform_emit_uniforms(void)
+{
+    for(int i = 0; i < IOS_WO49_TRANSFORM_UNIFORM_CAP; ++i) {
+        ios_wo49_transform_uniform_t *u = &ios_wo49_transform.uniform[i];
+        if(!u->required) continue;
+        ios_wo49_emit(
+            "WO49 transform uniform: token=%llu name=%s required=1 reflected=%d type=0x%04x extent=%d app_location=%d gl4es_location=%d native_location=%d expected_hash=%08x app_entry=%s app_integer=%d app_width=%d app_count=%d app_hash=%08x cache_seen=%d cache_width=%d cache_count=%d cache_hash=%08x native_entry=%s native_width=%d native_count=%d native_hash=%08x native_program=%u wrong_bound=%d wrong_bound_program=%u wrong_bound_hash=%08x",
+            ios_wo49_transform.producer.token, u->name, u->reflected,
+            u->reflected_type, u->reflected_extent, u->application_location,
+            u->gl4es_location, u->native_location, u->expected_hash,
+            u->app_entry[0] ? u->app_entry : "missing", u->app_integer,
+            u->app_width, u->app_count, u->app_hash, u->cache_seen,
+            u->cache_width, u->cache_count, u->cache_hash,
+            u->native_entry[0] ? u->native_entry : "missing", u->native_width,
+            u->native_count, u->native_hash, u->native_program, u->wrong_bound_seen,
+            u->wrong_bound_program, u->wrong_bound_hash);
+    }
+}
+
+static void ios_wo49_transform_terminal(const char *fallback_missing)
+{
+    const char *result = "full-application-to-native-transform-match";
+    const char *field = "none";
+    const char *reason = "all-required-fields-match";
+    int component = -1;
+    if(!ios_wo49_transform.claimed || ios_wo49_transform.terminal_emitted)
+        return;
+
+    if(ios_wo49_transform.source_mismatch) {
+        result = "application-source-transform-mismatch";
+        field = ios_wo49_transform.source_mismatch_field;
+        reason = "Diffusion-value-versus-GL4ES-matrix-state";
+        component = ios_wo49_transform.source_mismatch_component;
+    } else if(!ios_wo49_transform.armed) {
+        result = "incomplete/absent-evidence";
+        field = "token-arm";
+        reason = fallback_missing ? fallback_missing : "token-not-armed";
+    } else if(!ios_wo49_transform.program_seen) {
+        result = "incomplete/absent-evidence";
+        field = "realized-program";
+        reason = fallback_missing ? fallback_missing : "program-not-realized";
+    } else {
+        for(int i = 0; i < IOS_WO49_TRANSFORM_UNIFORM_CAP; ++i) {
+            ios_wo49_transform_uniform_t *u = &ios_wo49_transform.uniform[i];
+            const void *expected = ios_wo49_transform_expected_value(i);
+            if(!u->required) continue;
+            if(!u->reflected) {
+                result = "incomplete/absent-evidence"; field = u->name;
+                reason = "reflection-missing"; break;
+            }
+            if(u->reflected_type != ios_wo49_transform_expected_type(i) ||
+               u->reflected_extent < ios_wo49_transform_expected_count(i)) {
+                result = "GL4ES-reflection/cache-mismatch"; field = u->name;
+                reason = u->reflected_type != ios_wo49_transform_expected_type(i) ?
+                    "reflection-type" : "reflection-extent";
+                break;
+            }
+            if(!u->app_seen) {
+                result = "incomplete/absent-evidence"; field = u->name;
+                reason = "application-upload-missing"; break;
+            }
+            if(u->app_integer ||
+               u->app_width != ios_wo49_transform_expected_width(i) ||
+               u->app_count != ios_wo49_transform_expected_count(i) ||
+               u->app_hash != u->expected_hash) {
+                result = "application-source-transform-mismatch"; field = u->name;
+                reason = u->app_integer ? "application-entry-type" :
+                    u->app_width != ios_wo49_transform_expected_width(i) ?
+                    "application-width" :
+                    u->app_count != ios_wo49_transform_expected_count(i) ?
+                    "application-count" : "application-value";
+                component = ios_wo49_transform_first_component(expected,
+                    u->app_value, u->value_bytes);
+                break;
+            }
+            if(!u->cache_seen) {
+                result = "incomplete/absent-evidence"; field = u->name;
+                reason = "GL4ES-cache-missing"; break;
+            }
+            if(u->cache_width != u->app_width || u->cache_count != u->app_count ||
+               u->cache_hash != u->app_hash) {
+                result = "GL4ES-reflection/cache-mismatch"; field = u->name;
+                reason = u->cache_width != u->app_width ? "cache-width" :
+                    u->cache_count != u->app_count ? "cache-count" : "cache-value";
+                component = ios_wo49_transform_first_component(u->app_value,
+                    u->cache_value, u->value_bytes);
+                break;
+            }
+            if(!u->native_seen && u->wrong_bound_seen) {
+                result = "GL4ES-native-forward-mismatch"; field = u->name;
+                reason = "upload-before-selected-program-realization";
+                component = ios_wo49_transform_first_component(u->cache_value,
+                    u->app_value, u->value_bytes);
+                break;
+            }
+            if(!u->native_seen) {
+                result = "incomplete/absent-evidence"; field = u->name;
+                reason = "native-upload-missing"; break;
+            }
+            if(u->native_width != u->cache_width ||
+               u->native_count != u->cache_count ||
+               u->native_hash != u->cache_hash) {
+                result = "GL4ES-native-forward-mismatch"; field = u->name;
+                reason = u->native_width != u->cache_width ? "native-width" :
+                    u->native_count != u->cache_count ? "native-count" : "native-value";
+                component = ios_wo49_transform_first_component(u->cache_value,
+                    u->native_value, u->value_bytes);
+                break;
+            }
+        }
+    }
+
+    ios_wo49_transform_emit_uniforms();
+    ios_wo49_transform.terminal_emitted = 1;
+    ios_wo49_emit(
+        "WO49 transform terminal: token=%llu result=%s first_field=%s first_component=%d reason=%s terminal=1 tokens=1 programs=1 draws=1 frames=1 mutation=none error_queue=untouched",
+        ios_wo49_transform.producer.token, result, field, component, reason);
+}
+
+int APIENTRY_GL4ES gl4es_wo49_transform_begin(
+    const ios_wo49_transform_producer_desc_t *desc)
+{
+    GLfloat stack_mvp[16];
+    const char *logical_source;
+    if(!desc || ios_wo49_transform.claimed ||
+       desc->version != IOS_WO49_TRANSFORM_VERSION ||
+       desc->size != sizeof(*desc) || !desc->token ||
+       !(desc->flags & IOS_WO49_TRANSFORM_RIGID) ||
+       !(desc->flags & IOS_WO49_TRANSFORM_VERTEX_LIGHTING) ||
+       (desc->flags & IOS_WO49_TRANSFORM_BONE_WEIGHTING))
+        return 0;
+
+    memset(&ios_wo49_transform, 0, sizeof(ios_wo49_transform));
+    ios_wo49_transform.claimed = 1;
+    ios_wo49_transform.producer = *desc;
+    snprintf(ios_wo49_transform.producer_name,
+        sizeof(ios_wo49_transform.producer_name), "%s",
+        desc->producer ? desc->producer : "<none>");
+    snprintf(ios_wo49_transform.map, sizeof(ios_wo49_transform.map), "%s",
+        desc->map ? desc->map : "<none>");
+    snprintf(ios_wo49_transform.model, sizeof(ios_wo49_transform.model), "%s",
+        desc->model ? desc->model : "<none>");
+    ios_wo49_transform.producer.producer = ios_wo49_transform.producer_name;
+    ios_wo49_transform.producer.map = ios_wo49_transform.map;
+    ios_wo49_transform.producer.model = ios_wo49_transform.model;
+
+    ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_MVP].name = "MVP";
+    ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_MVP].value_bytes = 64;
+    ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_MODELVIEW].name = "modelview";
+    ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_MODELVIEW].value_bytes = 64;
+    ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_BONE_QUATERNION].name = "u_BoneQuaternion[0]";
+    ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_BONE_QUATERNION].value_bytes = 16;
+    ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_BONE_POSITION].name = "u_BonePosition[0]";
+    ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_BONE_POSITION].value_bytes = 12;
+    ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_SWAY_HEIGHT].name = "u_FoliageSwayHeight";
+    ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_SWAY_HEIGHT].value_bytes = 4;
+    for(int i = 0; i < IOS_WO49_TRANSFORM_UNIFORM_CAP; ++i) {
+        ios_wo49_transform_uniform_t *u = &ios_wo49_transform.uniform[i];
+        u->required = i != IOS_WO49_TRANSFORM_SWAY_HEIGHT ||
+            (desc->flags & IOS_WO49_TRANSFORM_SWAY);
+        u->application_location = -1;
+        u->gl4es_location = -1;
+        u->native_location = -1;
+        if(u->required)
+            u->expected_hash = ios_wo49_bytes_checksum(
+                ios_wo49_transform_expected_value(i), u->value_bytes);
+    }
+    ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_BONE_QUATERNION].application_location =
+        desc->boneQuaternionLocation;
+    ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_BONE_POSITION].application_location =
+        desc->bonePositionLocation;
+    for(int i = IOS_WO49_TRANSFORM_MVP; i <= IOS_WO49_TRANSFORM_MODELVIEW; ++i) {
+        ios_wo49_transform_uniform_t *u = &ios_wo49_transform.uniform[i];
+        u->app_seen = 1;
+        u->app_width = 16;
+        u->app_count = 1;
+        u->app_hash = u->expected_hash;
+        snprintf(u->app_entry, sizeof(u->app_entry), "glLoadMatrixf");
+        ios_wo49_transform_copy_value(u->app_value,
+            ios_wo49_transform_expected_value(i), u->value_bytes);
+    }
+
+    ios_wo49_transform.producer_mv_hash = ios_wo49_bytes_checksum(desc->modelview, 64);
+    ios_wo49_transform.producer_projection_hash = ios_wo49_bytes_checksum(desc->projection, 64);
+    ios_wo49_transform.producer_mvp_hash = ios_wo49_bytes_checksum(desc->mvp, 64);
+    ios_wo49_transform.source_mv_hash = ios_wo49_bytes_checksum(getMVMat(), 64);
+    ios_wo49_transform.source_projection_hash = ios_wo49_bytes_checksum(getPMat(), 64);
+    matrix_mul(getPMat(), getMVMat(), stack_mvp);
+    ios_wo49_transform.source_mvp_hash = ios_wo49_bytes_checksum(stack_mvp, 64);
+    if(ios_wo49_transform.source_mv_hash != ios_wo49_transform.producer_mv_hash) {
+        ios_wo49_transform.source_mismatch = 1;
+        snprintf(ios_wo49_transform.source_mismatch_field,
+            sizeof(ios_wo49_transform.source_mismatch_field), "modelview");
+        ios_wo49_transform.source_mismatch_component =
+            ios_wo49_transform_first_component(desc->modelview, getMVMat(), 64);
+    } else if(ios_wo49_transform.source_projection_hash !=
+        ios_wo49_transform.producer_projection_hash) {
+        ios_wo49_transform.source_mismatch = 1;
+        snprintf(ios_wo49_transform.source_mismatch_field,
+            sizeof(ios_wo49_transform.source_mismatch_field), "projection");
+        ios_wo49_transform.source_mismatch_component =
+            ios_wo49_transform_first_component(desc->projection, getPMat(), 64);
+    } else if(ios_wo49_transform.source_mvp_hash != ios_wo49_transform.producer_mvp_hash) {
+        ios_wo49_transform.source_mismatch = 1;
+        snprintf(ios_wo49_transform.source_mismatch_field,
+            sizeof(ios_wo49_transform.source_mismatch_field), "MVP");
+        ios_wo49_transform.source_mismatch_component =
