+void APIENTRY_GL4ES gl4es_wo49_transform_finish(unsigned long long token)
+{
+    if(ios_wo49_transform.claimed && !ios_wo49_transform.terminal_emitted &&
+       ios_wo49_transform.producer.token == token)
+        ios_wo49_transform_terminal("immediately-pre-native-draw-record-missing");
+}
+
+void ios_wo49_transform_application_uniform(void *opaque_program, GLint location,
+    const char *entry, int width, int count, const void *value, int integer_value)
+{
+    program_t *program = (program_t *)opaque_program;
+    uniform_t *uniform;
+    ios_wo49_transform_uniform_t *record;
+    int target;
+    if(!ios_wo49_transform.claimed || !program ||
+       program->id != ios_wo49_transform.logical_program ||
+       !(uniform = ios_wo49_transform_find_uniform(program, location)) ||
+       (target = ios_wo49_transform_target(uniform->name)) < 0)
+        return;
+    record = &ios_wo49_transform.uniform[target];
+    if(!record->required) return;
+    ios_wo49_transform_reflect(program, location, uniform);
+    record->app_seen = 1;
+    record->app_integer = integer_value;
+    record->app_width = width;
+    record->app_count = count;
+    record->app_hash = ios_wo49_bytes_checksum(value, record->value_bytes);
+    snprintf(record->app_entry, sizeof(record->app_entry), "%s", entry ? entry : "unknown");
+    ios_wo49_transform_copy_value(record->app_value, value, record->value_bytes);
+}
+
+void ios_wo49_transform_cache_uniform(void *opaque_program, GLint location,
+    int width, int count, const void *value)
+{
+    program_t *program = (program_t *)opaque_program;
+    uniform_t *uniform;
+    ios_wo49_transform_uniform_t *record;
+    int target;
+    if(!ios_wo49_transform.claimed || !program ||
+       !(uniform = ios_wo49_transform_find_uniform(program, location)) ||
+       (target = ios_wo49_transform_target(uniform->name)) < 0)
+        return;
+    record = &ios_wo49_transform.uniform[target];
+    if(!record->required) return;
+    ios_wo49_transform_reflect(program, location, uniform);
+    record->cache_seen = 1;
+    record->cache_width = width;
+    record->cache_count = count;
+    record->cache_hash = ios_wo49_bytes_checksum(value, record->value_bytes);
+    ios_wo49_transform_copy_value(record->cache_value, value, record->value_bytes);
+}
+
+void ios_wo49_transform_native_uniform(void *opaque_program, GLint location,
+    const char *entry, int width, int count, const void *value)
+{
+    program_t *program = (program_t *)opaque_program;
+    uniform_t *uniform;
+    ios_wo49_transform_uniform_t *record;
+    int target;
+    unsigned int hash;
+    if(!ios_wo49_transform.claimed || !program ||
+       !(uniform = ios_wo49_transform_find_uniform(program, location)) ||
+       (target = ios_wo49_transform_target(uniform->name)) < 0)
+        return;
+    record = &ios_wo49_transform.uniform[target];
+    if(!record->required) return;
+    hash = ios_wo49_bytes_checksum(value, record->value_bytes);
+    if(glstate->gleshard->program == program->id &&
+       glstate->gleshard->glprogram == program) {
+        record->native_seen = 1;
+        record->native_width = width;
+        record->native_count = count;
+        record->native_hash = hash;
+        record->native_program = program->id;
+        snprintf(record->native_entry, sizeof(record->native_entry), "%s",
+            entry ? entry : "unknown");
+        ios_wo49_transform_copy_value(record->native_value, value,
+            record->value_bytes);
+    } else {
+        record->wrong_bound_seen = 1;
+        record->wrong_bound_program = glstate->gleshard->program;
+        record->wrong_bound_hash = hash;
+    }
+}
+
+void ios_wo49_transform_program_realized(void *opaque_program)
+{
+    program_t *program = (program_t *)opaque_program;
+    const char *source;
+    uniform_t *uniform;
+    khint_t k;
+    if(!ios_wo49_transform.claimed || !ios_wo49_transform.armed ||
+       ios_wo49_transform.program_seen || !program)
+        return;
+    ios_wo49_transform.program_seen = 1;
+    ios_wo49_transform.native_program = program->id;
+    source = program->last_vert ? (program->last_vert->converted ?
+        program->last_vert->converted : program->last_vert->source) : NULL;
+    ios_wo49_transform.native_shader_hash = ios_wo49_bytes_checksum(
+        source, source ? strlen(source) : 0);
+    ios_wo49_transform.rigid_branch_present = source &&
+        strstr(source, "u_BoneQuaternion[0]") &&
+        strstr(source, "u_BonePosition[0]");
+    ios_wo49_transform.position_branch_present = source &&
+        (strstr(source, "_gl4es_ModelViewProjectionMatrix") ||
+         strstr(source, "gl_ModelViewProjectionMatrix")) &&
+        strstr(source, "worldpos");
+    kh_foreach(program->uniform, k, uniform,
+        ios_wo49_transform_reflect(program, (GLint)k, uniform);
+    )
+    ios_wo49_emit(
+        "WO49 transform program: token=%llu logical_program=%u realized_program=%u options_hash=%08x logical_vertex_hash=%08x converted_vertex_hash=%08x option_set=MAXSTUDIOBONES1+STUDIO_VERTEX_LIGHTING%s gl_position_branch=rigid-bone0%s-then-MVP rigid_branch_present=%d position_branch_present=%d",
+        ios_wo49_transform.producer.token, ios_wo49_transform.logical_program,
+        program->id, ios_wo49_transform.producer.optionsHash,
+        ios_wo49_transform.logical_shader_hash,
+        ios_wo49_transform.native_shader_hash,
+        (ios_wo49_transform.producer.flags & IOS_WO49_TRANSFORM_SWAY) ?
+            "+STUDIO_SWAY_FOLIAGE" : "",
+        (ios_wo49_transform.producer.flags & IOS_WO49_TRANSFORM_SWAY) ?
+            "+conditional-sway" : "",
+        ios_wo49_transform.rigid_branch_present,
+        ios_wo49_transform.position_branch_present);
+}
+
+void ios_wo49_transform_before_draw(const char *function, GLenum mode,
+    GLsizei count, GLenum type)
+{
+    if(!ios_wo49_transform.claimed || ios_wo49_transform.terminal_emitted ||
+       ios_wo49_active_token != ios_wo49_transform.producer.token)
+        return;
+    ios_wo49_transform.before_draw_seen = 1;
+    ios_wo49_emit(
+        "WO49 transform native: token=%llu function=%s mode=0x%04x count=%d type=0x%04x realized_program=%u expected_program=%u mv_location=%d mv_hash=%08x mvp_location=%d mvp_hash=%08x bone_quaternion_location=%d bone_quaternion_hash=%08x bone_position_location=%d bone_position_hash=%08x immediately_pre_native_draw=1",
+        ios_wo49_transform.producer.token, function ? function : "<none>",
+        mode, count, type, glstate->gleshard->program,
+        ios_wo49_transform.native_program,
+        ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_MODELVIEW].native_location,
+        ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_MODELVIEW].native_hash,
+        ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_MVP].native_location,
+        ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_MVP].native_hash,
+        ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_BONE_QUATERNION].native_location,
+        ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_BONE_QUATERNION].native_hash,
+        ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_BONE_POSITION].native_location,
+        ios_wo49_transform.uniform[IOS_WO49_TRANSFORM_BONE_POSITION].native_hash);
+    ios_wo49_transform_terminal(NULL);
+}
