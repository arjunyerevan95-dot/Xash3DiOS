     hardext.texture_array = 0;
     hardext.maxarraylayers = 0;
     if(native_es_major>=3 && texture_array_procs) {
@@ -487,7 +516,7 @@ void GetHardwareExtensions(int notest)
     if(hardext.esversion>1) {
         if(testGLSL("#version 120", 1))
             hardext.glsl120 = 1;
-        if(testGLSL("#version 300 es", 0))
+        if(testGLSL300ES())
             hardext.glsl300es = 1;
         if(testGLSL("#version 310 es", 1))
             hardext.glsl310es = 1;
@@ -538,3 +567,16 @@ void GetHardwareExtensions(int notest)
     egl_eglTerminate(eglDisplay);
 #endif
 }
+
+EXPORT
+void gl4es_get_texture_array_provider_state(int *native_es_major, int *procedures,
+    int *max_layers, int *glsl300, int *route_available, int *advertised)
+{
+    if(native_es_major) *native_es_major = hardext.texture_array_native_es_major;
+    if(procedures) *procedures = hardext.texture_array_procs;
+    if(max_layers) *max_layers = hardext.maxarraylayers;
+    if(glsl300) *glsl300 = hardext.glsl300es ? 1 : 0;
+    if(route_available) *route_available = hardext.texture_array_route;
+    if(advertised) *advertised = hardext.texture_array && hardext.glsl300es &&
+        hardext.maxarraylayers >= 16 && hardext.texture_array_route;
+}
