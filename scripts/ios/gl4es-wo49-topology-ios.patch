+void ios_wo49_topology_set_replay(const unsigned long long *tokens,
+    const GLuint *offsets, const GLuint *counts, unsigned int token_count,
+    const GLuint *owned_indices, unsigned long long vertex_bytes,
+    unsigned long long index_bytes)
+{
+    memset(&ios_wo49_replay, 0, sizeof(ios_wo49_replay));
+    ios_wo49_replay.count = token_count > IOS_WO49_TOPOLOGY_TOKEN_CAP ?
+        IOS_WO49_TOPOLOGY_TOKEN_CAP : token_count;
+    for(unsigned int i = 0; i < ios_wo49_replay.count; ++i) {
+        ios_wo49_record_t *record;
+        ios_wo49_replay.tokens[i] = tokens[i];
+        ios_wo49_replay.offsets[i] = offsets[i];
+        ios_wo49_replay.counts[i] = counts[i];
+        record = ios_wo49_find(tokens[i]);
+        if(record) {
+            record->route_count = (GLsizei)counts[i];
+            ios_wo49_emit_route(record, 1);
+        }
+    }
+    ios_wo49_replay.owned_indices = owned_indices;
+    ios_wo49_replay.vertex_bytes = vertex_bytes;
+    ios_wo49_replay.index_bytes = index_bytes;
+}
+
+static ios_wo49_attr_state_t *ios_wo49_logical_attr(
+    ios_wo49_record_t *record, unsigned int index)
+{
+    for(unsigned int i = 0; i < record->logical_attr_count; ++i)
+        if(record->logical_attrs[i].index == index)
+            return &record->logical_attrs[i];
+    return NULL;
+}
+
+static const ios_wo49_topology_attr_desc_t *ios_wo49_producer_attr(
+    const ios_wo49_record_t *record, unsigned int index)
+{
+    for(unsigned int i = 0; i < record->producer.attrCount; ++i)
+        if(record->producer.attrs[i].index == index)
+            return &record->producer.attrs[i];
+    return NULL;
+}
+
+static void ios_wo49_mismatch(ios_wo49_record_t *record, const char *field,
+    unsigned long long producer, unsigned long long ingress,
+    unsigned long long realized)
+{
+    if(record->mismatch_emitted)
+        return;
+    record->mismatch_emitted = 1;
+    ios_wo49_emit(
+        "WO49 topology mismatch: token=%llu field=%s producer=%llu ingress=%llu realized=%llu route=%s",
+        record->id, field, producer, ingress, realized,
+        record->route[0] ? record->route : "unknown");
+}
+
+static void ios_wo49_realize_one(ios_wo49_record_t *record, const char *function,
+    GLenum mode, GLsizei native_count, GLenum type, const void *indices,
+    const GLuint *owned_indices, GLuint segment_offset, GLuint segment_count,
+    unsigned long long replay_vertex_bytes, unsigned long long replay_index_bytes)
+{
+    if(!record || record->absence_emitted || record->stage >= 4)
+        return;
+    const GLuint *segment = owned_indices ? owned_indices + segment_offset : NULL;
+    GLuint minimum = 0, maximum = 0;
+    uint32_t checksum = 0;
+    GLuint native_ebo = glstate->bind_buffer.index;
+    unsigned long long native_ebo_bytes = replay_index_bytes;
+    char attrs[2304] = "";
+    size_t used = 0;
+    int position_seen = 0;
+    int bounds_ok = 1;
+    int deferred = strcmp(record->route, "direct") != 0;
+    unsigned int active_attr_count = 0;
+
+    if(!segment && type == GL_UNSIGNED_INT) {
+        if(native_ebo && glstate->vao->elements && glstate->vao->elements->data &&
+           (uintptr_t)indices + (uintptr_t)record->ingress_count * sizeof(GLuint) <=
+               (uintptr_t)glstate->vao->elements->size) {
+            segment = (const GLuint *)((const unsigned char *)glstate->vao->elements->data +
+                (uintptr_t)indices);
+            segment_count = record->ingress_count;
+            native_ebo_bytes = (unsigned long long)glstate->vao->elements->size;
+        } else if(!native_ebo) {
+            segment = (const GLuint *)indices;
+            segment_count = record->ingress_count;
+        }
+    }
+    if(segment && segment_count) {
+        ios_index_minmax(segment, (GLsizei)segment_count, &minimum, &maximum);
+        checksum = ios_index_checksum(segment, (GLsizei)segment_count);
+    }
+
+    /* Compare immutable producer facts to wrapper ingress before considering
+     * translated native state. The first call wins and is emitted only once. */
+    if(record->ingress_mode != record->producer.mode)
+        ios_wo49_mismatch(record, "primitive-mode", record->producer.mode,
+            record->ingress_mode, mode);
+    if(!record->mismatch_emitted && record->logical_vao != record->producer.vao)
+        ios_wo49_mismatch(record, "logical-vao", record->producer.vao,
+            record->logical_vao, 0);
+    if(!record->mismatch_emitted && record->logical_vbo != record->producer.vbo)
+        ios_wo49_mismatch(record, "logical-vbo", record->producer.vbo,
+            record->logical_vbo, 0);
+    if(!record->mismatch_emitted && record->logical_ebo != record->producer.ebo)
+        ios_wo49_mismatch(record, "logical-ebo", record->producer.ebo,
+            record->logical_ebo, native_ebo);
+    if(!record->mismatch_emitted && record->logical_ebo_bytes != record->producer.eboBytes)
+        ios_wo49_mismatch(record, "logical-ebo-size", record->producer.eboBytes,
+            record->logical_ebo_bytes, native_ebo_bytes);
+    if(!record->mismatch_emitted && record->logical_vertex_checksum != record->producer.vertexChecksum)
+        ios_wo49_mismatch(record, "vertex-upload-checksum", record->producer.vertexChecksum,
+            record->logical_vertex_checksum, 0);
+    if(!record->mismatch_emitted && record->logical_position_checksum != record->producer.positionChecksum)
+        ios_wo49_mismatch(record, "position-upload-checksum", record->producer.positionChecksum,
+            record->logical_position_checksum, 0);
+    if(!record->mismatch_emitted && record->ingress_type != record->producer.indexType)
+        ios_wo49_mismatch(record, "ingress-index-type", record->producer.indexType,
+            record->ingress_type, type);
+    if(!record->mismatch_emitted && record->ingress_count != (GLsizei)record->producer.numElems)
+        ios_wo49_mismatch(record, "ingress-index-count", record->producer.numElems,
+            record->ingress_count, native_count);
+    if(!record->mismatch_emitted && record->ingress_checksum != record->producer.indexChecksum)
+        ios_wo49_mismatch(record, "ingress-index-checksum", record->producer.indexChecksum,
+            record->ingress_checksum, checksum);
+    if(!record->mismatch_emitted && record->ingress_min != record->producer.indexMin)
+        ios_wo49_mismatch(record, "ingress-index-min", record->producer.indexMin,
+            record->ingress_min, minimum);
+    if(!record->mismatch_emitted && record->ingress_max != record->producer.indexMax)
+        ios_wo49_mismatch(record, "ingress-index-max", record->producer.indexMax,
+            record->ingress_max, maximum);
+    if(!record->mismatch_emitted && record->ingress_base != record->producer.baseVertex)
+        ios_wo49_mismatch(record, "base-vertex", record->producer.baseVertex,
+            record->ingress_base, 0);
+    if(!record->mismatch_emitted && record->ingress_start != record->producer.rangeStart)
+        ios_wo49_mismatch(record, "range-start", record->producer.rangeStart,
+            record->ingress_start, 0);
+    if(!record->mismatch_emitted && record->ingress_end != record->producer.rangeEnd)
+        ios_wo49_mismatch(record, "range-end", record->producer.rangeEnd,
+            record->ingress_end, 0);
+    for(unsigned int i = 0; i < record->producer.attrCount && !record->mismatch_emitted; ++i) {
+        const ios_wo49_topology_attr_desc_t *p = &record->producer.attrs[i];
+        ios_wo49_attr_state_t *logical = ios_wo49_logical_attr(record, p->index);
+        if(!logical)
+            ios_wo49_mismatch(record, "logical-attribute-missing", p->index, 0, 0);
+        else if(logical->enabled != (int)p->enabled)
+            ios_wo49_mismatch(record, "logical-attribute-enabled", p->enabled,
+                logical->enabled, 0);
+        else if(logical->buffer != record->producer.vbo)
+            ios_wo49_mismatch(record, "logical-attribute-buffer", record->producer.vbo,
+                logical->buffer, 0);
+        else if(logical->size != (GLint)p->size)
+            ios_wo49_mismatch(record, "logical-attribute-size", p->size, logical->size, 0);
+        else if(logical->type != p->type)
+            ios_wo49_mismatch(record, "logical-attribute-type", p->type, logical->type, 0);
+        else if(logical->normalized != (int)p->normalized)
+            ios_wo49_mismatch(record, "logical-attribute-normalized", p->normalized,
+                logical->normalized, 0);
+        else if(logical->integer != (int)p->integer)
+            ios_wo49_mismatch(record, "logical-attribute-integer", p->integer,
+                logical->integer, 0);
+        else if(logical->stride != (GLsizei)p->stride)
+            ios_wo49_mismatch(record, "logical-attribute-stride", p->stride,
+                logical->stride, 0);
+        else if((unsigned long long)logical->pointer != p->offset)
+            ios_wo49_mismatch(record, "logical-attribute-offset", p->offset,
+                logical->pointer, 0);
+        else if(logical->buffer_bytes != record->producer.vboBytes)
+            ios_wo49_mismatch(record, "logical-attribute-buffer-size",
+                record->producer.vboBytes, logical->buffer_bytes, 0);
+        else if(logical->in_bounds == 0)
+            ios_wo49_mismatch(record, "logical-attribute-bounds",
+                record->producer.highestPackedVertexByte, logical->highest_byte, 0);
+    }
+
+    program_t *program = glstate->gleshard->glprogram;
+    for(unsigned int index = 0; index < (unsigned int)hardext.maxvattrib &&
+        index < IOS_WO49_TOPOLOGY_ATTR_CAP; ++index) {
+        vertexattrib_t *native_attr;
+        ios_wo49_attr_state_t *logical;
+        unsigned int width;
+        unsigned long long stride;
+        unsigned long long pointer;
+        unsigned long long buffer_bytes;
+        unsigned long long highest;
+        int in_bounds;
+        if(!program || !program->va_size[index])
+            continue;
+        ++active_attr_count;
+        native_attr = &glstate->gleshard->vertexattrib[index];
+        logical = ios_wo49_logical_attr(record, index);
+        width = ios_index_type_bytes(native_attr->type);
+        stride = native_attr->stride ? (unsigned long long)native_attr->stride :
+            (unsigned long long)width * (unsigned long long)native_attr->size;
+        pointer = (unsigned long long)(uintptr_t)(native_attr->real_buffer ?
+            native_attr->real_pointer : native_attr->pointer);
+        buffer_bytes = native_attr->buffer ?
+            (unsigned long long)native_attr->buffer->size : replay_vertex_bytes;
+        highest = pointer + (unsigned long long)maximum * stride +
+            (unsigned long long)width * (unsigned long long)native_attr->size - 1u;
+        in_bounds = buffer_bytes ? highest < buffer_bytes : -1;
+        if(index == record->producer.attrs[0].index)
+            position_seen = native_attr->enabled;
+        if(in_bounds == 0)
+            bounds_ok = 0;
+        ios_wo49_append(attrs, sizeof(attrs), &used,
+            "%sa%u=e%d/b%u/bytes%llu/c%d/t0x%04x/n%d/i%d/s%d/o%llu/d%d/high%llu/ok%d",
+            used ? "," : "", index, native_attr->enabled,
+            native_attr->real_buffer, buffer_bytes, native_attr->size,
+            native_attr->type, native_attr->normalized, native_attr->integer,
+            native_attr->stride, pointer, native_attr->divisor, highest, in_bounds);
+        if(!record->mismatch_emitted && !native_attr->enabled)
+            ios_wo49_mismatch(record, "attribute-enabled", 1,
+                logical ? logical->enabled : 0, native_attr->enabled);
+        if(!record->mismatch_emitted && !deferred && logical) {
+            if(native_attr->real_buffer != logical->native_buffer)
+                ios_wo49_mismatch(record, "attribute-buffer", logical->buffer,
+                    logical->native_buffer, native_attr->real_buffer);
+            else if(native_attr->stride != logical->stride)
+                ios_wo49_mismatch(record, "attribute-stride", logical->stride,
+                    logical->stride, native_attr->stride);
+            else if(pointer != (unsigned long long)logical->pointer)
+                ios_wo49_mismatch(record, "attribute-offset", logical->pointer,
+                    logical->pointer, pointer);
+            else if(native_attr->size != logical->size)
+                ios_wo49_mismatch(record, "attribute-size", logical->size,
+                    logical->size, native_attr->size);
+            else if(native_attr->type != logical->type)
+                ios_wo49_mismatch(record, "attribute-type", logical->type,
+                    logical->type, native_attr->type);
+            else if(native_attr->normalized != logical->normalized)
+                ios_wo49_mismatch(record, "attribute-normalized", logical->normalized,
+                    logical->normalized, native_attr->normalized);
+            else if(native_attr->integer != logical->integer)
+                ios_wo49_mismatch(record, "attribute-integer", logical->integer,
+                    logical->integer, native_attr->integer);
+            else if(native_attr->divisor != logical->divisor)
+                ios_wo49_mismatch(record, "attribute-divisor", logical->divisor,
+                    logical->divisor, native_attr->divisor);
+        }
+        if(!record->mismatch_emitted && !deferred &&
+           !ios_wo49_producer_attr(record, index))
+            ios_wo49_mismatch(record, "native-active-attribute-unexpected", 0,
+                logical ? 1 : 0, index);
+        if(!record->mismatch_emitted && deferred && native_attr->real_buffer &&
+           native_attr->real_buffer != glstate->bind_buffer.array)
+            ios_wo49_mismatch(record, "deferred-attribute-buffer", glstate->bind_buffer.array,
+                0, native_attr->real_buffer);
+        if(!record->mismatch_emitted && in_bounds == 0)
+            ios_wo49_mismatch(record, "attribute-bounds", record->producer.vboBytes,
+                logical ? logical->buffer_bytes : 0, highest);
+    }
+
+    if(!record->mismatch_emitted && type != record->producer.indexType)
+        ios_wo49_mismatch(record, "index-type", record->producer.indexType,
+            record->ingress_type, type);
+    if(!record->mismatch_emitted && segment_count != record->producer.numElems)
+        ios_wo49_mismatch(record, "index-count", record->producer.numElems,
+            record->ingress_count, segment_count);
+    if(!record->mismatch_emitted && checksum != record->route_checksum)
+        ios_wo49_mismatch(record, "index-checksum", record->producer.indexChecksum,
+            record->route_checksum, checksum);
+    if(!record->mismatch_emitted && minimum != record->route_min)
+        ios_wo49_mismatch(record, "index-min", record->producer.indexMin,
+            record->route_min, minimum);
+    if(!record->mismatch_emitted && maximum != record->route_max)
+        ios_wo49_mismatch(record, "index-max", record->producer.indexMax,
+            record->route_max, maximum);
+    if(!record->mismatch_emitted && record->route_position_checksum != record->producer.positionChecksum)
+        ios_wo49_mismatch(record, "route-position-checksum",
+            record->producer.positionChecksum, record->route_position_checksum, 0);
+    if(!record->mismatch_emitted && mode != record->producer.mode)
+        ios_wo49_mismatch(record, "native-primitive-mode", record->producer.mode,
+            record->ingress_mode, mode);
+    if(!record->mismatch_emitted && !deferred &&
+       native_ebo != record->logical_native_ebo)
+        ios_wo49_mismatch(record, "native-ebo", record->producer.ebo,
+            record->logical_native_ebo, native_ebo);
+    if(!record->mismatch_emitted && !deferred && !native_ebo)
+        ios_wo49_mismatch(record, "index-source", record->producer.ebo,
+            record->logical_ebo, native_ebo);
+    if(!record->mismatch_emitted && !position_seen)
+        ios_wo49_mismatch(record, "position-attribute", 1, 1, 0);
+    if(!record->mismatch_emitted && !active_attr_count)
+        ios_wo49_mismatch(record, "active-attribute-set", record->producer.attrCount,
+            record->logical_attr_count, 0);
+
+    record->stage = 4;
+    ios_wo49_emit(
+        "WO49 topology realized: token=%llu function=%s route=%s mode=0x%04x native_vao=0 vao_policy=gl4es-emulated array_binding=%u ebo=%u ebo_bytes=%llu source=%s pointer_or_offset=0x%llx native_draw_count=%d segment_count=%u type=0x%04x min=%u max=%u checksum=%08x attrs=[%s] position_present=%d bounds_ok=%d match=%d comparison=producer+ingress+route-aware-realized",
+        record->id, function, record->route, mode, glstate->bind_buffer.array,
+        native_ebo, native_ebo_bytes, native_ebo ? "ebo-offset" : "client-pointer",
+        (unsigned long long)(uintptr_t)indices, native_count, segment_count,
+        type, minimum, maximum, checksum, attrs, position_seen, bounds_ok,
+        !record->mismatch_emitted);
+}
+
+void ios_wo49_topology_realized(const char *function, GLenum mode, GLsizei count,
+    GLenum type, const void *indices)
+{
+    if(ios_wo49_active_token) {
+        ios_wo49_record_t *record = ios_wo49_find(ios_wo49_active_token);
+        if(record)
+            ios_wo49_realize_one(record, function, mode, count, type, indices,
+                NULL, 0, 0, 0, 0);
+        ios_wo49_active_token = 0;
+    }
+    for(unsigned int i = 0; i < ios_wo49_replay.count; ++i) {
+        ios_wo49_record_t *record = ios_wo49_find(ios_wo49_replay.tokens[i]);
+        if(record)
+            ios_wo49_realize_one(record, function, mode, count, type, indices,
+                ios_wo49_replay.owned_indices, ios_wo49_replay.offsets[i],
+                ios_wo49_replay.counts[i], ios_wo49_replay.vertex_bytes,
+                ios_wo49_replay.index_bytes);
+    }
+    memset(&ios_wo49_replay, 0, sizeof(ios_wo49_replay));
+}
+
+void APIENTRY_GL4ES gl4es_wo49_topology_finish(unsigned long long token)
+{
+    ios_wo49_record_t *record = ios_wo49_find(token);
+    if(!record)
+        return;
+    record->finished = 1;
+    if(record->stage == 1 && !record->absence_emitted)
+        gl4es_wo49_topology_absence(token, "wrapper-ingress-missing");
+    else if(record->stage == 2 && !record->absence_emitted)
+        gl4es_wo49_topology_absence(token, "route-ownership-missing");
+    else if(record->stage == 3 && !record->absence_emitted &&
+        strcmp(record->route, "direct") == 0)
+        gl4es_wo49_topology_absence(token, "post-realization-missing");
+    if(ios_wo49_record_count == IOS_WO49_TOPOLOGY_TOKEN_CAP) {
+        int complete = 1;
+        for(unsigned int i = 0; i < ios_wo49_record_count; ++i)
+            if(ios_wo49_records[i].stage < 4 && !ios_wo49_records[i].absence_emitted)
+                complete = 0;
+        if(complete)
+            ios_wo49_summary_if_due(ios_index_frame, 1);
+    }
+}
+
+static void ios_wo49_summary_if_due(unsigned long long frame, int force)
+{
+    char tokens[768] = "";
+    size_t used = 0;
+    unsigned int realized = 0, mismatched = 0, absent = 0;
+    if(ios_wo49_summary_emitted || !ios_wo49_record_count)
+        return;
+    if(!force && frame <= ios_wo49_first_frame)
+        return;
+    for(unsigned int i = 0; i < ios_wo49_record_count; ++i) {
+        ios_wo49_record_t *record = &ios_wo49_records[i];
+        if(record->stage < 4 && !record->absence_emitted) {
+            const char *reason = record->stage == 1 ? "producer-only" :
+                (record->stage == 2 && record->route[0] ? "deferred-replay-absent" :
+                (record->stage == 2 ? "ingress-without-route" : "post-realization-absent"));
+            gl4es_wo49_topology_absence(record->id, reason);
+        }
+        if(record->stage >= 4) ++realized;
+        if(record->mismatch_emitted) ++mismatched;
+        if(record->absence_emitted) ++absent;
+        ios_wo49_append(tokens, sizeof(tokens), &used,
+            "%st%llu:%s:%s", i ? "," : "", record->id,
+            ios_wo49_stage_name(record), record->absence_emitted ? record->absence :
+            (record->mismatch_emitted ? "mismatch" : "match"));
+    }
+    ios_wo49_summary_emitted = 1;
+    ios_wo49_emit(
+        "WO49 topology summary: tokens=%u cap=4 realized=%u mismatched=%u absent=%u terminal=1 stages=[%s] first_mismatch_per_token=bounded records_per_stage<=1 mutation=none",
+        ios_wo49_record_count, realized, mismatched, absent, tokens);
+}
