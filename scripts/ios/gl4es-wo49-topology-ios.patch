+static void ios_wo49_emit(const char *format, ...)
+{
+    char buffer[4096];
+    va_list args;
+    if(!ios_index_logger || ios_index_logger_busy)
+        return;
+    va_start(args, format);
+    vsnprintf(buffer, sizeof(buffer), format, args);
+    va_end(args);
+    buffer[sizeof(buffer) - 1] = '\0';
+    ios_index_logger_busy = 1;
+    ios_index_logger(buffer);
+    ios_index_logger_busy = 0;
+}
+
+static ios_wo49_record_t *ios_wo49_find(unsigned long long id)
+{
+    for(unsigned int i = 0; i < ios_wo49_record_count; ++i)
+        if(ios_wo49_records[i].id == id)
+            return &ios_wo49_records[i];
+    return NULL;
+}
+
+static void ios_wo49_append(char *buffer, size_t capacity, size_t *used,
+    const char *format, ...)
+{
+    va_list args;
+    int written;
+    if(*used >= capacity)
+        return;
+    va_start(args, format);
+    written = vsnprintf(buffer + *used, capacity - *used, format, args);
+    va_end(args);
+    if(written < 0)
+        return;
+    if((size_t)written >= capacity - *used)
+        *used = capacity - 1;
+    else
+        *used += (size_t)written;
+}
+
+static uint32_t ios_wo49_position_checksum(const GLfloat *positions,
+    GLsizei stride, GLuint count)
+{
+    uint32_t hash = 2166136261u;
+    const unsigned char *base = (const unsigned char *)positions;
+    size_t actual_stride = stride > 0 ? (size_t)stride : sizeof(GLfloat) * 4;
+    if(!positions)
+        return 0;
+    for(GLuint vertex = 0; vertex < count; ++vertex) {
+        const unsigned char *bytes = base + (size_t)vertex * actual_stride;
+        for(size_t i = 0; i < sizeof(GLfloat) * 3; ++i) {
+            hash ^= bytes[i];
+            hash *= 16777619u;
+        }
+    }
+    return hash;
+}
+
+static uint32_t ios_wo49_bytes_checksum(const void *data, size_t size)
+{
+    uint32_t hash = 2166136261u;
+    const unsigned char *bytes = (const unsigned char *)data;
+    if(!data)
+        return 0;
+    for(size_t i = 0; i < size; ++i) {
+        hash ^= bytes[i];
+        hash *= 16777619u;
+    }
+    return hash;
+}
+
+static void ios_wo49_capture_logical_attr(ios_wo49_attr_state_t *out,
+    unsigned int index, GLuint maximum)
+{
+    vertexattrib_t *attr = &glstate->vao->vertexattrib[index];
+    unsigned int width = ios_index_type_bytes(attr->type);
+    unsigned long long stride = attr->stride ? (unsigned long long)attr->stride :
+        (unsigned long long)width * (unsigned long long)attr->size;
+    memset(out, 0, sizeof(*out));
+    out->index = index;
+    out->enabled = attr->enabled;
+    out->size = attr->size;
+    out->type = attr->type;
+    out->normalized = attr->normalized;
+    out->integer = attr->integer;
+    out->stride = attr->stride;
+    out->pointer = (uintptr_t)attr->pointer;
+    out->divisor = attr->divisor;
+    if(attr->buffer) {
+        out->buffer = attr->buffer->buffer;
+        out->native_buffer = attr->buffer->real_buffer;
+        out->buffer_bytes = (unsigned long long)attr->buffer->size;
+    }
+    out->highest_byte = (unsigned long long)out->pointer +
+        (unsigned long long)maximum * stride +
+        (unsigned long long)width * (unsigned long long)attr->size - 1u;
+    out->in_bounds = out->buffer_bytes ? out->highest_byte < out->buffer_bytes : -1;
+}
