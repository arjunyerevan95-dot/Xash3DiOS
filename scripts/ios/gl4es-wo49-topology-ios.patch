+unsigned long long APIENTRY_GL4ES gl4es_wo49_topology_producer(
+    const ios_wo49_topology_producer_desc_t *desc)
+{
+    ios_wo49_record_t *record;
+    char attrs[1536] = "";
+    size_t used = 0;
+    if(!desc || desc->version != IOS_WO49_TOPOLOGY_VERSION ||
+       desc->size != sizeof(*desc) || desc->aggregateVerts <= 65535u ||
+       !desc->meshIdentity || !desc->numVerts || !desc->numElems)
+        return 0;
+    for(unsigned int i = 0; i < ios_wo49_record_count; ++i)
+        if(ios_wo49_records[i].producer.meshIdentity == desc->meshIdentity)
+            return 0;
+    if(ios_wo49_record_count >= IOS_WO49_TOPOLOGY_TOKEN_CAP)
+        return 0;
+
+    record = &ios_wo49_records[ios_wo49_record_count++];
+    memset(record, 0, sizeof(*record));
+    record->id = ++ios_wo49_next_id;
+    record->producer = *desc;
+    record->producer.attrCount = desc->attrCount > IOS_WO49_TOPOLOGY_ATTR_CAP ?
+        IOS_WO49_TOPOLOGY_ATTR_CAP : desc->attrCount;
+    memcpy(record->producer.attrs, desc->attrs,
+        record->producer.attrCount * sizeof(desc->attrs[0]));
+    snprintf(record->producer_name, sizeof(record->producer_name), "%s",
+        desc->producer ? desc->producer : "<none>");
+    snprintf(record->model, sizeof(record->model), "%s",
+        desc->model ? desc->model : "<none>");
+    record->producer.producer = record->producer_name;
+    record->producer.model = record->model;
+    record->stage = 1;
+    if(!ios_wo49_first_frame)
+        ios_wo49_first_frame = desc->frame;
+
+    for(unsigned int i = 0; i < record->producer.attrCount; ++i) {
+        const ios_wo49_topology_attr_desc_t *a = &record->producer.attrs[i];
+        ios_wo49_append(attrs, sizeof(attrs), &used,
+            "%sa%u=e%u/c%u/t0x%04x/n%u/i%u/s%u/o%llu",
+            i ? "," : "", a->index, a->enabled, a->size, a->type,
+            a->normalized, a->integer, a->stride, a->offset);
+    }
+    ios_wo49_emit(
+        "WO49 topology producer: token=%llu frame=%llu map=%s producer=%s model=%s cache=0x%llx instance=0x%llx mesh=0x%llx aggregate_verts=%u local_verts=%u elems=%u mode=0x%04x index_type=0x%04x index_source=ebo-upload min=%u max=%u checksum=%08x base=%d range=%u..%u layout=%u stride=%u vao=%u vbo=%u ebo=%u vbo_bytes=%llu ebo_bytes=%llu vertex_upload=%llu index_upload=%llu vertex_checksum=%08x position_checksum=%08x highest_local=%llu highest_packed_byte=%llu submission=not-yet-known attrs=[%s]",
+        record->id, desc->frame, ios_index_map, record->producer_name,
+        record->model, desc->cacheIdentity, desc->instanceIdentity,
+        desc->meshIdentity, desc->aggregateVerts, desc->numVerts,
+        desc->numElems, desc->mode, desc->indexType, desc->indexMin,
+        desc->indexMax, desc->indexChecksum, desc->baseVertex,
+        desc->rangeStart, desc->rangeEnd, desc->layout, desc->stride,
+        desc->vao, desc->vbo, desc->ebo, desc->vboBytes, desc->eboBytes,
+        desc->vertexUploadOffset, desc->indexUploadOffset,
+        desc->vertexChecksum, desc->positionChecksum,
+        desc->highestLocalVertex, desc->highestPackedVertexByte, attrs);
+    return record->id;
+}
+
+void APIENTRY_GL4ES gl4es_wo49_topology_arm(unsigned long long token)
+{
+    ios_wo49_record_t *record = ios_wo49_find(token);
+    if(!record || record->stage != 1 || record->absence_emitted)
+        return;
+    ios_wo49_pending_token = token;
+}
+
+void APIENTRY_GL4ES gl4es_wo49_topology_absence(unsigned long long token,
+    const char *reason)
+{
+    ios_wo49_record_t *record = ios_wo49_find(token);
+    if(!record || record->absence_emitted || record->stage >= 4)
+        return;
+    record->absence_emitted = 1;
+    snprintf(record->absence, sizeof(record->absence), "%s", reason ? reason : "unknown");
+    ios_wo49_emit("WO49 topology absence: token=%llu furthest=%s reason=%s",
+        token, ios_wo49_stage_name(record), record->absence);
+    if(ios_wo49_pending_token == token)
+        ios_wo49_pending_token = 0;
+}
+
+unsigned long long ios_wo49_topology_ingress(const char *function, GLenum mode,
+    GLsizei count, GLenum type, const void *caller_indices, const GLuint *resolved,
+    GLuint start, GLuint end, GLint basevertex, int deferred, int intercept)
+{
+    unsigned long long token = ios_wo49_pending_token;
+    ios_wo49_record_t *record;
+    char attrs[2048] = "";
+    size_t used = 0;
+    if(!token)
+        return 0;
+    ios_wo49_pending_token = 0;
+    record = ios_wo49_find(token);
+    if(!record || record->absence_emitted)
+        return 0;
+    if(!resolved || count <= 0) {
+        gl4es_wo49_topology_absence(token, "unresolved-index-source");
+        return 0;
+    }
+
+    snprintf(record->function, sizeof(record->function), "%s", function ? function : "<none>");
+    record->ingress_pointer = (uintptr_t)caller_indices;
+    record->ingress_mode = mode;
+    record->ingress_type = type;
+    record->ingress_count = count;
+    record->ingress_start = start;
+    record->ingress_end = end;
+    record->ingress_base = basevertex;
+    if(type == GL_UNSIGNED_INT) {
+        ios_index_minmax(resolved, count, &record->ingress_min, &record->ingress_max);
+        record->ingress_checksum = ios_index_checksum(resolved, count);
+    }
+    record->logical_vao = glstate->vao->array;
+    if(glstate->vao->elements) {
+        record->logical_ebo = glstate->vao->elements->buffer;
+        record->logical_native_ebo = glstate->vao->elements->real_buffer;
+        record->logical_ebo_bytes = (unsigned long long)glstate->vao->elements->size;
+    }
+    record->logical_attr_count = record->producer.attrCount;
+    for(unsigned int i = 0; i < record->logical_attr_count; ++i) {
+        unsigned int index = record->producer.attrs[i].index;
+        ios_wo49_attr_state_t *a = &record->logical_attrs[i];
+        if(index >= (unsigned int)hardext.maxvattrib)
+            continue;
+        ios_wo49_capture_logical_attr(a, index, record->ingress_max);
+        if(index == record->producer.attrs[0].index) {
+            vertexattrib_t *position = &glstate->vao->vertexattrib[index];
+            record->logical_vbo = a->buffer;
+            if(position->buffer && position->buffer->data) {
+                record->logical_vertex_checksum = ios_wo49_bytes_checksum(
+                    position->buffer->data, (size_t)position->buffer->size);
+                if(a->in_bounds == 1)
+                    record->logical_position_checksum = ios_wo49_position_checksum(
+                        (const GLfloat *)((const unsigned char *)position->buffer->data +
+                            a->pointer), a->stride, record->producer.numVerts);
+            }
+        }
+        ios_wo49_append(attrs, sizeof(attrs), &used,
+            "%sa%u=e%d/b%u/nb%u/bytes%llu/c%d/t0x%04x/n%d/i%d/s%d/o%llu/d%d/high%llu/ok%d",
+            i ? "," : "", a->index, a->enabled, a->buffer,
+            a->native_buffer, a->buffer_bytes, a->size, a->type,
+            a->normalized, a->integer, a->stride,
+            (unsigned long long)a->pointer, a->divisor, a->highest_byte,
+            a->in_bounds);
+    }
+    record->stage = 2;
+    ios_wo49_emit(
+        "WO49 topology ingress: token=%llu function=%s mode=0x%04x count=%d type=0x%04x range=%u..%u base=%d source=%s pointer_or_offset=0x%llx min=%u max=%u checksum=%08x route=%s logical_vao=%u array_buffer=%u ebo=%u native_ebo=%u ebo_bytes=%llu vertex_checksum=%08x position_checksum=%08x attrs=[%s]",
+        token, record->function, mode, count, type, start, end, basevertex,
+        record->logical_ebo ? "ebo-offset" : "client-pointer",
+        (unsigned long long)record->ingress_pointer, record->ingress_min,
+        record->ingress_max, record->ingress_checksum,
+        deferred ? (intercept ? "intercept" : "deferred") : "direct",
+        record->logical_vao, record->logical_vbo, record->logical_ebo,
+        record->logical_native_ebo, record->logical_ebo_bytes,
+        record->logical_vertex_checksum, record->logical_position_checksum, attrs);
+    return token;
+}
+
+static void ios_wo49_emit_route(ios_wo49_record_t *record, int replay)
+{
+    if(record->stage >= 3)
+        return;
+    record->stage = 3;
+    ios_wo49_emit(
+        "WO49 topology route: token=%llu owner=%s copied=%d normalized=%d rebased=%d appended=%d replay=%d count=%d min=%u max=%u checksum=%08x vertex_first=%u vertex_count=%u position_checksum=%08x position_match=%d storage=fixed-owned",
+        record->id, record->route, strcmp(record->route, "direct") != 0,
+        strcmp(record->route, "direct") != 0, record->ingress_base != 0,
+        record->route_appended, replay, record->route_count,
+        record->route_min, record->route_max, record->route_checksum,
+        record->route_vertex_first, record->route_vertex_count,
+        record->route_position_checksum,
+        record->route_position_checksum == record->producer.positionChecksum);
+}
+
+void ios_wo49_topology_route(unsigned long long token, const char *route,
+    const GLuint *indices, GLsizei count, GLuint vertex_first, GLuint vertex_count,
+    int appended, const GLfloat *positions, GLsizei position_stride)
+{
+    ios_wo49_record_t *record = ios_wo49_find(token);
+    if(!record || record->absence_emitted || record->stage < 2)
+        return;
+    if(indices && count > 0) {
+        ios_index_minmax(indices, count, &record->route_min, &record->route_max);
+        record->route_checksum = ios_index_checksum(indices, count);
+    }
+    record->route_position_checksum = positions ?
+        ios_wo49_position_checksum(positions, position_stride, vertex_count) :
+        record->producer.positionChecksum;
+    record->route_vertex_first = vertex_first;
+    record->route_vertex_count = vertex_count;
+    record->route_count = count;
+    record->route_appended |= appended;
+    snprintf(record->route, sizeof(record->route), "%s", route ? route : "unknown");
+    if(strcmp(record->route, "direct") == 0)
+        ios_wo49_emit_route(record, 0);
+}
+
