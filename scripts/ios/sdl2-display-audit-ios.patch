+#define XASH_AUDIT_SAMPLE_EDGE 4
+#define XASH_AUDIT_SAMPLE_COUNT 5
+
+static Uint32 XASH_AuditHashBytes(Uint32 hash, const GLubyte *bytes, size_t count)
+{
+    size_t i;
+
+    for (i = 0; i < count; ++i) {
+        hash ^= bytes[i];
+        hash *= 16777619u;
+    }
+    return hash;
+}
+
+static void XASH_AuditDrainErrors(char *buffer, size_t bufferSize)
+{
+    GLenum error;
+    int count = 0;
+
+    buffer[0] = '\0';
+    while (count < 16 && (error = glGetError()) != GL_NO_ERROR) {
+        if (count < 8) {
+            size_t length = SDL_strlen(buffer);
+            SDL_snprintf(buffer + length, bufferSize - length, "%s0x%04x",
+                         count ? "," : "", (unsigned int)error);
+        }
+        ++count;
+    }
+
+    if (!count) {
+        SDL_strlcpy(buffer, "none", bufferSize);
+    } else if (count > 8) {
+        size_t length = SDL_strlen(buffer);
+        SDL_snprintf(buffer + length, bufferSize - length, ",+%d", count - 8);
+    }
+}
