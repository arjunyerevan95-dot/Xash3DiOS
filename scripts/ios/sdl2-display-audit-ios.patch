+- (Uint32)xashDrawableChecksumWithStatus:(GLenum *)statusOut
+{
+    const GLint points[XASH_AUDIT_SAMPLE_COUNT][2] = {
+        { 8, 8 },
+        { backingWidth - XASH_AUDIT_SAMPLE_EDGE - 8, 8 },
+        { 8, backingHeight - XASH_AUDIT_SAMPLE_EDGE - 8 },
+        { backingWidth - XASH_AUDIT_SAMPLE_EDGE - 8, backingHeight - XASH_AUDIT_SAMPLE_EDGE - 8 },
+        { backingWidth / 2, backingHeight / 2 }
+    };
+    GLubyte pixels[XASH_AUDIT_SAMPLE_EDGE * XASH_AUDIT_SAMPLE_EDGE * 4];
+    GLint previousFramebuffer = 0;
+    GLint previousDrawFramebuffer = 0;
+    GLint previousReadFramebuffer = 0;
+    Uint32 hash = 2166136261u;
+    GLenum status;
+    int i;
+
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &previousFramebuffer);
+    if (context.API >= kEAGLRenderingAPIOpenGLES3) {
+        glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &previousDrawFramebuffer);
+        glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &previousReadFramebuffer);
+    }
+
+    glBindFramebuffer(GL_FRAMEBUFFER, viewFramebuffer);
+    status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+    if (status == GL_FRAMEBUFFER_COMPLETE) {
+        for (i = 0; i < XASH_AUDIT_SAMPLE_COUNT; ++i) {
+            GLint x = SDL_max(0, SDL_min(points[i][0], backingWidth - XASH_AUDIT_SAMPLE_EDGE));
+            GLint y = SDL_max(0, SDL_min(points[i][1], backingHeight - XASH_AUDIT_SAMPLE_EDGE));
+
+            glReadPixels(x, y, XASH_AUDIT_SAMPLE_EDGE, XASH_AUDIT_SAMPLE_EDGE,
+                         GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+            hash = XASH_AuditHashBytes(hash, pixels, sizeof(pixels));
+        }
+    } else {
+        hash = 0;
+    }
+
+    if (context.API >= kEAGLRenderingAPIOpenGLES3) {
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, (GLuint)previousDrawFramebuffer);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, (GLuint)previousReadFramebuffer);
+    } else {
+        glBindFramebuffer(GL_FRAMEBUFFER, (GLuint)previousFramebuffer);
+    }
+
+    if (statusOut) {
+        *statusOut = status;
+    }
+    return hash;
+}
