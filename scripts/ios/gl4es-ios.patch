diff --git a/src/glx/hardext.c b/src/glx/hardext.c
--- a/src/glx/hardext.c
+++ b/src/glx/hardext.c
@@ -271,0 +272 @@ void GetHardwareExtensions(int notest)
+    const char *Version = (const char *) gles_glGetString(GL_VERSION);
@@ -276,0 +278,6 @@ void GetHardwareExtensions(int notest)
+    // Full NPOT texture support is core in OpenGL ES 3.0, so ES3 drivers do
+    // not need to repeat GL_OES_texture_npot in their extension strings.
+    if(Version && strstr(Version, "OpenGL ES 3.")) {
+        hardext.npot = 3;
+        SHUT_LOGD("Native GLES3 core NPOT support enabled\n");
+    }
