diff --git a/src/gl/texture_array.c b/src/gl/texture_array.c
new file mode 100644
index 00000000..614d6f7d
--- /dev/null
+++ b/src/gl/texture_array.c
@@ -0,0 +1,152 @@
+#include "texture.h"
+
+#include "debug.h"
+#include "glstate.h"
+#include "loader.h"
+#include "../glx/hardext.h"
+
+typedef void (APIENTRY_GL4ES *native_teximage3d_t)(GLenum, GLint, GLint,
+    GLsizei, GLsizei, GLsizei, GLint, GLenum, GLenum, const GLvoid *);
+typedef void (APIENTRY_GL4ES *native_texsubimage3d_t)(GLenum, GLint, GLint,
+    GLint, GLint, GLsizei, GLsizei, GLsizei, GLenum, GLenum, const GLvoid *);
+typedef void (APIENTRY_GL4ES *native_texstorage3d_t)(GLenum, GLsizei, GLenum,
+    GLsizei, GLsizei, GLsizei);
+
+static native_teximage3d_t native_teximage3d;
+static native_texsubimage3d_t native_texsubimage3d;
+static native_texstorage3d_t native_texstorage3d;
+
+static int load_texture_array_entrypoints(void)
+{
+    if(!hardext.texture_array || !gles_getProcAddress)
+        return 0;
+    if(!native_teximage3d)
+        native_teximage3d = (native_teximage3d_t)gles_getProcAddress("glTexImage3D");
+    if(!native_texsubimage3d)
+        native_texsubimage3d = (native_texsubimage3d_t)gles_getProcAddress("glTexSubImage3D");
+    if(!native_texstorage3d)
+        native_texstorage3d = (native_texstorage3d_t)gles_getProcAddress("glTexStorage3D");
+    return native_teximage3d && native_texsubimage3d && native_texstorage3d;
+}
+
+static const GLvoid *array_pixels(const GLvoid *data)
+{
+    if(data && glstate->vao->unpack)
+        return (const char *)glstate->vao->unpack->data + (uintptr_t)data;
+    return data;
+}
+
+int gl4es_texture_array_available(void)
+{
+    return load_texture_array_entrypoints();
+}
+
+void gl4es_texture_array_reset(void)
+{
+    native_teximage3d = NULL;
+    native_texsubimage3d = NULL;
+    native_texstorage3d = NULL;
+}
+
+void gl4es_texture_array_bind(int unit, GLuint texture)
+{
+    LOAD_GLES(glActiveTexture);
+    LOAD_GLES(glBindTexture);
+    if(!load_texture_array_entrypoints()) {
+        errorShim(GL_INVALID_OPERATION);
+        return;
+    }
+    if(glstate->gleshard->active != unit) {
+        glstate->gleshard->active = unit;
+        gles_glActiveTexture(GL_TEXTURE0 + unit);
+    }
+    gles_glBindTexture(GL_TEXTURE_2D_ARRAY, texture);
+    glstate->actual_texarray[unit] = texture;
+}
+
+static gltexture_t *array_bound(void)
+{
+    return glstate->texture.bound[glstate->texture.active][ENABLED_TEXTURE_ARRAY];
+}
+
+static int array_validate(GLenum target, GLsizei width, GLsizei height, GLsizei depth)
+{
+    if(target != GL_TEXTURE_2D_ARRAY) {
+        errorShim(GL_INVALID_ENUM);
+        return 0;
+    }
+    if(width < 0 || height < 0 || depth < 0 || depth > hardext.maxarraylayers) {
+        errorShim(GL_INVALID_VALUE);
+        return 0;
+    }
+    if(!load_texture_array_entrypoints()) {
+        errorShim(GL_INVALID_OPERATION);
+        return 0;
+    }
+    return 1;
+}
+
+void gl4es_texture_array_image(GLenum target, GLint level, GLint internalformat,
+    GLsizei width, GLsizei height, GLsizei depth, GLint border,
+    GLenum format, GLenum type, const GLvoid *data)
+{
+    gltexture_t *tex;
+    if(!array_validate(target, width, height, depth)) return;
+    tex = array_bound();
+    if(tex->immutable) {
+        errorShim(GL_INVALID_OPERATION);
+        return;
+    }
+    realize_bound(glstate->texture.active, target);
+    native_teximage3d(target, level, internalformat, width, height, depth,
+        border, format, type, array_pixels(data));
+    tex->width = width;
+    tex->height = height;
+    tex->depth = depth;
+    tex->format = format;
+    tex->type = type;
+    tex->internalformat = internalformat;
+    tex->valid = 1;
+    errorGL();
+}
+
+void gl4es_texture_array_subimage(GLenum target, GLint level, GLint xoffset,
+    GLint yoffset, GLint zoffset, GLsizei width, GLsizei height, GLsizei depth,
+    GLenum format, GLenum type, const GLvoid *data)
+{
+    gltexture_t *tex;
+    if(!array_validate(target, width, height, depth)) return;
+    tex = array_bound();
+    if(!tex->valid || xoffset < 0 || yoffset < 0 || zoffset < 0 ||
+       xoffset + width > tex->width || yoffset + height > tex->height ||
+       zoffset + depth > tex->depth) {
+        errorShim(GL_INVALID_VALUE);
+        return;
+    }
+    realize_bound(glstate->texture.active, target);
+    native_texsubimage3d(target, level, xoffset, yoffset, zoffset, width,
+        height, depth, format, type, array_pixels(data));
+    errorGL();
+}
+
+void gl4es_texture_array_storage(GLenum target, GLsizei levels,
+    GLenum internalformat, GLsizei width, GLsizei height, GLsizei depth)
+{
+    gltexture_t *tex;
+    if(!array_validate(target, width, height, depth)) return;
+    tex = array_bound();
+    if(levels <= 0 || tex->immutable) {
+        errorShim(levels <= 0 ? GL_INVALID_VALUE : GL_INVALID_OPERATION);
+        return;
+    }
+    realize_bound(glstate->texture.active, target);
+    native_texstorage3d(target, levels, internalformat, width, height, depth);
+    tex->width = width;
+    tex->height = height;
+    tex->depth = depth;
+    tex->internalformat = internalformat;
+    tex->immutable = GL_TRUE;
+    tex->immutable_levels = levels;
+    tex->valid = 1;
+    errorGL();
+}
